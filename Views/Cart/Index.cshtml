@model List<Webproject.Models.CartItem>

@{
    ViewData["Title"] = "My Cart";

    decimal cartTotal = Model?.Sum(x => x.Price * x.Quantity) ?? 0;
    int totalItems = Model?.Sum(x => x.Quantity) ?? 0;
}

<style>

 

    .luxe-cart-page {
        min-height: 100vh;
        padding: 65px 25px 80px;
        background: radial-gradient(circle at 10% 10%, rgba(198,161,91,.08), transparent 30%), radial-gradient(circle at 90% 90%, rgba(15,46,38,.08), transparent 35%), #F7F1E8;
    }

    .luxe-cart-wrapper {
        max-width: 1250px;
        margin: auto;
    }



    .cart-header {
        text-align: center;
        margin-bottom: 45px;
    }

    .cart-header-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #0F2E26;
        color: #C6A15B;
        font-size: 27px;
        border: 1px solid rgba(198,161,91,.5);
        box-shadow: 0 15px 35px rgba(15,46,38,.18), inset 0 0 20px rgba(198,161,91,.08);
    }

    .cart-header h1 {
        margin: 0;
        color: #0F2E26;
        font-size: 42px;
        font-weight: 700;
        letter-spacing: 6px;
    }

    .cart-header p {
        margin-top: 12px;
        color: #888;
        font-size: 14px;
        letter-spacing: 1.5px;
    }



    .cart-layout {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 30px;
        align-items: start;
    }



    .cart-products {
        background: rgba(255,255,255,.82);
        border: 1px solid rgba(198,161,91,.3);
        border-radius: 28px;
        padding: 28px;
        box-shadow: 0 20px 55px rgba(15,46,38,.09);
        backdrop-filter: blur(10px);
    }

    .products-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 22px;
        margin-bottom: 20px;
        border-bottom: 1px solid #eee;
    }

        .products-heading h2 {
            margin: 0;
            color: #0F2E26;
            font-size: 21px;
            letter-spacing: 1px;
        }

    .items-count {
        padding: 7px 13px;
        border-radius: 20px;
        background: rgba(198,161,91,.12);
        color: #9b7737;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
    }



    .luxe-cart-item {
        position: relative;
        display: grid;
        grid-template-columns: 95px 1fr auto;
        gap: 20px;
        align-items: center;
        padding: 20px;
        margin-bottom: 16px;
        background: #fff;
        border: 1px solid #eee;
        border-radius: 20px;
        transition: .35s ease;
        overflow: hidden;
    }

        .luxe-cart-item:last-child {
            margin-bottom: 0;
        }

        .luxe-cart-item::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 3px;
            height: 0;
            background: #C6A15B;
            transition: .4s ease;
        }

        .luxe-cart-item:hover {
            transform: translateY(-4px);
            border-color: rgba(198,161,91,.45);
            box-shadow: 0 15px 35px rgba(15,46,38,.09);
        }

            .luxe-cart-item:hover::before {
                height: 100%;
            }




    .cart-product-image {
        width: 95px;
        height: 95px;
        border-radius: 17px;
        overflow: hidden;
        background: linear-gradient( 145deg, #f8f5ef, #e9e2d5 );
        border: 1px solid rgba(198,161,91,.3);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .cart-product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: .5s ease;
        }

    .luxe-cart-item:hover .cart-product-image img {
        transform: scale(1.08);
    }

    .cart-placeholder {
        font-size: 30px;
        color: #C6A15B;
    }



    .cart-product-info {
        min-width: 0;
    }

        .cart-product-info h3 {
            margin: 0 0 8px;
            color: #0F2E26;
            font-size: 18px;
            font-weight: 700;
        }

        .cart-product-info .unit-price {
            color: #9b7737;
            font-size: 14px;
            font-weight: 600;
        }

        .cart-product-info small {
            display: block;
            margin-top: 7px;
            color: #999;
            font-size: 11px;
            letter-spacing: .5px;
        }


 

    .cart-item-actions {
        display: flex;
        align-items: center;
        gap: 20px;
    }



    .quantity-control {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 5px;
        border: 1px solid #ddd;
        border-radius: 30px;
        background: #fafafa;
    }

    .quantity-btn {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: #0F2E26;
        text-decoration: none;
        transition: .3s ease;
    }

        .quantity-btn:hover {
            background: #0F2E26;
            color: #C6A15B;
        }

    .quantity-number {
        min-width: 25px;
        text-align: center;
        color: #0F2E26;
        font-size: 14px;
        font-weight: 700;
    }


  

    .remove-cart-btn {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: #b23a48;
        border: 1px solid rgba(178,58,72,.25);
        text-decoration: none;
        transition: .3s ease;
    }

        .remove-cart-btn:hover {
            background: #b23a48;
            color: white;
            transform: rotate(8deg);
        }



    .cart-summary-card {
        position: sticky;
        top: 25px;
        background: #0F2E26;
        border-radius: 28px;
        padding: 32px;
        color: white;
        border: 1px solid rgba(198,161,91,.5);
        box-shadow: 0 25px 55px rgba(15,46,38,.22);
        overflow: hidden;
    }

        .cart-summary-card::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -80px;
            top: -80px;
            border-radius: 50%;
            border: 1px solid rgba(198,161,91,.15);
        }

    .summary-label {
        color: #C6A15B;
        font-size: 11px;
        letter-spacing: 3px;
        font-weight: 700;
    }

    .summary-title {
        margin: 8px 0 25px;
        color: white;
        font-size: 25px;
    }




    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid rgba(255,255,255,.09);
        color: #bbb;
        font-size: 13px;
    }

        .summary-row strong {
            color: white;
        }

    .summary-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        padding-top: 18px;
        border-top: 1px solid rgba(198,161,91,.35);
    }

        .summary-total span {
            color: white;
            font-size: 14px;
            letter-spacing: 1px;
        }

        .summary-total strong {
            color: #C6A15B;
            font-size: 30px;
        }




    .confirm-order-btn {
        position: relative;
        width: 100%;
        margin-top: 28px;
        padding: 15px;
        border: 1px solid #C6A15B;
        border-radius: 14px;
        background: #C6A15B;
        color: #0F2E26;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 1.5px;
        cursor: pointer;
        overflow: hidden;
        transition: .35s ease;
    }

        .confirm-order-btn:hover {
            background: transparent;
            color: #C6A15B;
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(198,161,91,.2);
        }



    .continue-shopping-btn {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
        padding: 13px;
        border-radius: 14px;
        color: #C6A15B;
        border: 1px solid rgba(198,161,91,.35);
        text-decoration: none;
        font-size: 12px;
        transition: .3s ease;
    }

        .continue-shopping-btn:hover {
            background: rgba(198,161,91,.1);
            color: white;
        }


    .empty-cart {
        max-width: 650px;
        margin: 30px auto;
        padding: 70px 30px;
        text-align: center;
        background: white;
        border-radius: 30px;
        border: 1px solid rgba(198,161,91,.3);
        box-shadow: 0 20px 50px rgba(15,46,38,.1);
    }

    .empty-cart-icon {
        width: 90px;
        height: 90px;
        margin: 0 auto 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #0F2E26;
        color: #C6A15B;
        font-size: 35px;
    }

    .empty-cart h2 {
        margin: 0;
        color: #0F2E26;
        font-size: 27px;
    }

    .empty-cart p {
        color: #888;
        margin: 10px 0 25px;
    }

    .explore-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 13px 28px;
        border-radius: 30px;
        background: #0F2E26;
        color: #C6A15B;
        border: 1px solid #C6A15B;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: .3s ease;
    }

        .explore-btn:hover {
            background: #C6A15B;
            color: #0F2E26;
            transform: translateY(-3px);
        }




    @@media (max-width: 950px) {

        .cart-layout {
            grid-template-columns: 1fr;
        }

        .cart-summary-card {
            position: relative;
            top: auto;
        }
    }


    @@media (max-width: 650px) {

        .luxe-cart-page {
            padding: 40px 15px 60px;
        }

        .cart-header h1 {
            font-size: 32px;
            letter-spacing: 4px;
        }

        .cart-products {
            padding: 18px;
        }

        .luxe-cart-item {
            grid-template-columns: 75px 1fr;
            gap: 15px;
        }

        .cart-product-image {
            width: 75px;
            height: 75px;
        }

        .cart-item-actions {
            grid-column: 1 / -1;
            justify-content: space-between;
            padding-top: 12px;
            border-top: 1px solid #eee;
        }

        .cart-summary-card {
            padding: 25px;
        }
    }

</style>


<div class="luxe-cart-page">

    <div class="luxe-cart-wrapper">


        <div class="cart-header">

            <div class="cart-header-icon">
                <i class="fa-solid fa-bag-shopping"></i>
            </div>

            <h1>
                YOUR CART
            </h1>

            <p>
                Curated pieces waiting to become yours
            </p>

        </div>


        @if (Model != null && Model.Any())
        {

            <div class="cart-layout">



                <div class="cart-products">

                    <div class="products-heading">

                        <h2>
                            Selected Pieces
                        </h2>

                        <span class="items-count">
                            @totalItems ITEMS
                        </span>

                    </div>


                    @foreach (var item in Model)
                    {

                        <div class="luxe-cart-item">


                       

                            <div class="cart-product-image">

                                <div class="cart-placeholder">
                                    <i class="fa-solid fa-gem"></i>
                                </div>

                            </div>



                            <div class="cart-product-info">

                                <h3>
                                    @item.ProductName
                                </h3>

                                <div class="unit-price">
                                    $@item.Price.ToString("N2")
                                </div>

                                <small>
                                    Luxury Collection
                                </small>

                            </div>


                      

                            <div class="cart-item-actions">

                                <div class="quantity-control">

                                    <a asp-action="Decrease"
                                       asp-route-id="@item.ProductId"
                                       class="quantity-btn">

                                        <i class="fa-solid fa-minus"></i>

                                    </a>

                                    <span class="quantity-number">
                                        @item.Quantity
                                    </span>

                                    <a asp-action="Increase"
                                       asp-route-id="@item.ProductId"
                                       class="quantity-btn">

                                        <i class="fa-solid fa-plus"></i>

                                    </a>

                                </div>


                                <a asp-action="Remove"
                                   asp-route-id="@item.ProductId"
                                   class="remove-cart-btn"
                                   title="Remove">

                                    <i class="fa-solid fa-trash"></i>

                                </a>

                            </div>

                        </div>

                    }

                </div>


        

                <div class="cart-summary-card">

                    <span class="summary-label">
                        LUXE CHECKOUT
                    </span>

                    <h2 class="summary-title">
                        Order Summary
                    </h2>


                    <div class="summary-row">

                        <span>
                            Items
                        </span>

                        <strong>
                            @totalItems
                        </strong>

                    </div>


                    <div class="summary-row">

                        <span>
                            Subtotal
                        </span>

                        <strong>
                            $@cartTotal.ToString("N2")
                        </strong>

                    </div>


                    <div class="summary-row">

                        <span>
                            Delivery
                        </span>

                        <strong>
                            Complimentary
                        </strong>

                    </div>


                    <div class="summary-total">

                        <span>
                            TOTAL
                        </span>

                        <strong>
                            $@cartTotal.ToString("N2")
                        </strong>

                    </div>



                    <form asp-controller="Orders"
                          asp-action="ConfirmOrder"
                          method="post">

                        @foreach (var item in Model)
                        {
                            <input type="hidden"
                                   name="selectedProducts"
                                   value="@item.ProductId" />
                        }

                        <button type="submit"
                                class="confirm-order-btn">

                            <i class="fa-solid fa-lock"></i>

                            &nbsp; CONFIRM ORDER

                        </button>

                    </form>


         

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="continue-shopping-btn">

                        <i class="fa-solid fa-arrow-left"></i>

                        Continue Shopping

                    </a>

                </div>

            </div>

        }
        else
        {

    

            <div class="empty-cart">

                <div class="empty-cart-icon">

                    <i class="fa-solid fa-bag-shopping"></i>

                </div>

                <h2>
                    Your Cart Is Empty
                </h2>

                <p>
                    Your next luxury piece is waiting for you.
                </p>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="explore-btn">

                    <i class="fa-solid fa-gem"></i>

                    Explore Collection

                </a>

            </div>

        }

    </div>

</div>