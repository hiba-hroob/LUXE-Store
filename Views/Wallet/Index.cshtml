@model Webproject.Models.User

@{
    ViewData["Title"] = "My Wallet";
}

<style>

    .wallet-page {
        min-height: 78vh;
        padding: 55px 20px;
        color: white;
    }


    .wallet-header {
        max-width: 1050px;
        margin: 0 auto 35px;
    }

        .wallet-header small {
            color: #C6A15B;
            letter-spacing: 4px;
            text-transform: uppercase;
            font-size: 12px;
        }

        .wallet-header h1 {
            font-size: 42px;
            margin: 8px 0;
            color: #111;
            font-weight: 600;
        }

        .wallet-header p {
            color: #888;
            margin: 0;
        }


    .wallet-container {
        max-width: 1050px;
        margin: auto;
        display: grid;
        grid-template-columns: 1.15fr .85fr;
        gap: 30px;
    }



    .luxe-wallet-card {
        min-height: 310px;
        padding: 35px;
        border-radius: 28px;
        position: relative;
        overflow: hidden;
        background: linear-gradient( 135deg, #173e32, #0c241d );
        border: 1px solid rgba(198,161,91,.45);
        box-shadow: 0 25px 60px rgba(0,0,0,.5), inset 0 0 50px rgba(198,161,91,.04);
    }

        .luxe-wallet-card::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            border: 1px solid rgba(198,161,91,.12);
            right: -100px;
            top: -120px;
        }

        .luxe-wallet-card::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            border: 1px solid rgba(198,161,91,.08);
            left: -120px;
            bottom: -130px;
        }

    .wallet-card-top {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .luxe-logo {
        color: #C6A15B;
        font-size: 23px;
        font-weight: bold;
        letter-spacing: 4px;
    }

    .wallet-icon {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #C6A15B;
        border: 1px solid rgba(198,161,91,.35);
        background: rgba(255,255,255,.05);
    }

    .balance-section {
        position: relative;
        z-index: 2;
        margin-top: 55px;
    }

    .balance-label {
        color: rgba(255,255,255,.55);
        font-size: 12px;
        letter-spacing: 3px;
    }

    .balance {
        font-size: 52px;
        font-weight: 600;
        color: #C6A15B;
        margin-top: 8px;
    }

    .wallet-card-bottom {
        position: absolute;
        left: 35px;
        right: 35px;
        bottom: 28px;
        display: flex;
        justify-content: space-between;
        color: rgba(255,255,255,.55);
        font-size: 12px;
    }

    .wallet-status {
        color: #C6A15B;
    }

    

    .wallet-actions {
        padding: 35px;
        border-radius: 28px;
        background: rgba(255,255,255,.06);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(198,161,91,.25);
        box-shadow: 0 20px 50px rgba(0,0,0,.4);
    }

        .wallet-actions h2 {
            margin: 0 0 10px;
            font-size: 24px;
            color: #222;
        }

        .wallet-actions p {
            color: #888;
            line-height: 1.6;
            font-size: 14px;
            margin-bottom: 28px;
        }

    .add-money-btn {
        width: 100%;
        padding: 16px;
        border-radius: 14px;
        border: 1px solid #C6A15B;
        background: #1A4639;
        color: #C6A15B;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: .3s ease;
    }

        .add-money-btn:hover {
            background: #C6A15B;
            color: #111;
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(198,161,91,.25);
        }

    .wallet-security {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 25px;
        color: #777;
        font-size: 12px;
    }

        .wallet-security i {
            color: #C6A15B;
        }

    
    .wallet-info {
        max-width: 1050px;
        margin: 30px auto 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .info-box {
        padding: 22px;
        border-radius: 18px;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(198,161,91,.16);
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .info-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #C6A15B;
        background: rgba(198,161,91,.08);
    }

    .info-box strong {
        display: block;
        color: #222;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .info-box span {
        color: #888;
        font-size: 12px;
    }

    

    @@media (max-width: 800px) {

        .wallet-container {
            grid-template-columns: 1fr;
        }

        .wallet-info {
            grid-template-columns: 1fr;
        }

        .wallet-header h1 {
            font-size: 34px;
        }

        .balance {
            font-size: 42px;
        }
    }

</style>

<div class="wallet-page">

   
   

    <div class="wallet-header">

        <small>
            LUXE Financial
        </small>

        <h1>
            My Wallet
        </h1>

        <p>
            Manage your funds and enjoy a seamless LUXE experience.
        </p>

    </div>


    

    <div class="wallet-container">


        <div class="luxe-wallet-card">

            <div class="wallet-card-top">

                <div class="luxe-logo">
                    LUXE
                </div>

                <div class="wallet-icon">
                    <i class="fa-solid fa-wallet"></i>
                </div>

            </div>


            <div class="balance-section">

                <div class="balance-label">
                    AVAILABLE BALANCE
                </div>

                <div class="balance">
                    $@Model.WalletBalance.ToString("N2")
                </div>

            </div>


            <div class="wallet-card-bottom">

                <span>
                    LUXE MEMBER
                </span>

                <span class="wallet-status">
                    <i class="fa-solid fa-circle"></i>
                    Active
                </span>

            </div>

        </div>


        

        <div class="wallet-actions">

            <h2>
                Manage Your Wallet
            </h2>

            <p>
                Add funds securely to your LUXE wallet
                and use your balance for your purchases.
            </p>


            <a asp-controller="Wallet"
               asp-action="AddMoney"
               class="add-money-btn">

                <i class="fa-solid fa-plus"></i>

                Add Money

            </a>


            <div class="wallet-security">

                <i class="fa-solid fa-shield-halved"></i>

                <span>
                    Your wallet information is securely protected.
                </span>

            </div>

        </div>

    </div>


 

    <div class="wallet-info">

        <div class="info-box">

            <div class="info-icon">
                <i class="fa-solid fa-credit-card"></i>
            </div>

            <div>

                <strong>
                    Easy Payments
                </strong>

                <span>
                    Fast and simple checkout
                </span>

            </div>

        </div>


        <div class="info-box">

            <div class="info-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <div>

                <strong>
                    Secure Wallet
                </strong>

                <span>
                    Protected account balance
                </span>

            </div>

        </div>


        <div class="info-box">

            <div class="info-icon">
                <i class="fa-solid fa-star"></i>
            </div>

            <div>

                <strong>
                    LUXE Experience
                </strong>

                <span>
                    Premium shopping made easy
                </span>

            </div>

        </div>

    </div>
  

</div>
