@model List<Webproject.Models.Message>

@{
    ViewData["Title"] = "Messages";
}

<style>

    .messages-page {
        min-height: 85vh;
        padding: 60px;
        background: #F7F1E8;
    }

    .messages-header {
        text-align: center;
        margin-bottom: 45px;
    }

        .messages-header h1 {
            color: #111;
            font-size: 42px;
            letter-spacing: 7px;
            margin-bottom: 10px;
        }

        .messages-header p {
            color: #777;
            letter-spacing: 2px;
        }

    .messages-container {
        max-width: 850px;
        margin: auto;
    }

    .message-card {
        position: relative;
        background: #111;
        border: 1px solid rgba(198,161,91,.45);
        border-radius: 18px;
        padding: 25px 30px;
        margin-bottom: 20px;
        overflow: hidden;
        transition: .35s;
    }

        .message-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: #C6A15B;
        }

        .message-card:hover {
            transform: translateY(-5px);
            border-color: #C6A15B;
            box-shadow: 0 15px 35px rgba(198,161,91,.25);
        }

    .message-icon {
        color: #C6A15B;
        font-size: 24px;
        margin-right: 12px;
    }

    .message-content {
        color: white;
        font-size: 17px;
        letter-spacing: 1px;
        line-height: 1.7;
    }

    .message-date {
        margin-top: 12px;
        color: #888;
        font-size: 13px;
        letter-spacing: 1px;
    }

    .empty-messages {
        text-align: center;
        background: #111;
        border: 1px solid rgba(198,161,91,.4);
        border-radius: 20px;
        padding: 60px 30px;
        color: #888;
    }

        .empty-messages i {
            color: #C6A15B;
            font-size: 45px;
            margin-bottom: 20px;
        }

        .send-message-container
        { width: 100%; display: flex; justify-content: center; align-items: center; margin-top: 35px; margin-bottom: 40px; }
        .send-message-btn { display: inline-flex; align-items: center; justify-content: 
            center; gap: 10px; padding: 14px 36px; background: #0F2E26; color: #C6A15B !important; border: 1px solid #C6A15B; 
            border-radius: 14px; text-decoration: none !important; font-size: 14px; font-weight: 600; letter-spacing: 2px; position: 
            relative; overflow: hidden; transition: .35s ease; box-shadow: 0 5px 18px rgba(0,0,0,.2); } 
            .send-message-btn::before { content: ""; position: absolute; top: 0; left: -120%; width: 100%; height: 100%;
                background: linear-gradient( 120deg, transparent, rgba(255,255,255,.45), transparent ); transition: .5s; } 
                .send-message-btn:hover { color: white !important;  background: #0F2E26;
                    transform: translateY(-4px); border-color: #C6A15B;
                    box-shadow: 0 10px 30px rgba(198,161,91,.35), 0 0 15px rgba(198,161,91,.2); } 
                    .send-message-btn:hover::before { left: 120%; } 
                    .send-message-btn i { color: #C6A15B; transition: .35s; } 
                    .send-message-btn:hover i { color: white; transform: translateX(3px); }


.message-sender {
color: #C6A15B;

font-size: 14px;

margin-bottom: 12px;

letter-spacing: 1px;

}

.message-sender i {

margin-right: 6px;

}

.message-sender strong {

color: white;

}

.message-sender span {

color: #888;

font-size: 12px;

margin-left: 5px;

}
.message-actions {
    display: flex;
    gap: 10px;
    margin-top: 18px;
}

.message-action {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 16px;
    border-radius: 10px;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 1px;
    cursor: pointer;
    transition: .3s;
}

.reply-btn {
    background: #0F2E26;
    color: #C6A15B;
    border: 1px solid #C6A15B;
}

.reply-btn:hover {
    background: #C6A15B;
    color: #111;
}

.delete-btn {
    background: #3a1515;
    color: #ff8b8b;
    border: 1px solid #8b3030;
}

.delete-btn:hover {
    background: #8b3030;
    color: white;
}

.message-actions form {
    margin: 0;
}


</style>

<div class="messages-page">

    <div class="messages-header">

        <h1>
            MESSAGES
        </h1>

        <p>
            Your personal messages
        </p>

    </div>


    <div class="messages-container">

        @if (Model != null && Model.Any())
        {
            foreach (var message in Model)
            {

                <div class="message-card">

                    <div class="message-content">

                        @if (Context.Session.GetString("IsAdmin") == "true")
                        {
                            <div class="message-sender">

                                <i class="fa-solid fa-user"></i>

                                From:

                                <strong>
                                    @message.User?.FullName
                                </strong>

                                <span>
                                    (@message.User?.Email)
                                </span>

                            </div>
                        }

                        <i class="fa-solid fa-envelope message-icon"></i>

                        @message.Content

                    </div>


                    <div class="message-date">

                        <i class="fa-regular fa-clock"></i>

                        @message.CreatedAt.ToString("dd MMM yyyy - hh:mm tt")

                    </div>


                   
                    <div class="message-actions">

                        @if (Context.Session.GetString("IsAdmin") == "true")
                        {


                            <a asp-controller="Messages"
                               asp-action="Reply"
                               asp-route-id="@message.Id"
                               class="message-action reply-btn">

                                <i class="fa-solid fa-reply"></i>

                                Reply

                            </a>
                        }
                        else if (message.IsFromAdmin)
                        {
                         

                            <a asp-controller="Messages"
                               asp-action="Reply"
                               asp-route-id="@message.Id"
                               class="message-action reply-btn">

                                <i class="fa-solid fa-reply"></i>

                                Reply

                            </a>
                        }


                       

                        <form asp-controller="Messages"
                              asp-action="Delete"
                              asp-route-id="@message.Id"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to delete this message?');">

                            <button type="submit"
                                    class="message-action delete-btn">

                                <i class="fa-solid fa-trash"></i>

                                Delete

                            </button>

                        </form>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="empty-messages">

                <i class="fa-regular fa-envelope"></i>

                <h3>
                    No Messages Yet
                </h3>

                <p>
                    You don't have any messages at the moment.
                </p>

            </div>
        }

    </div>


  

    <div class="send-message-container">

        <a asp-controller="Messages"
           asp-action="Send"
           class="send-message-btn">

            <i class="fa-solid fa-paper-plane"></i>

            @if (Context.Session.GetString("IsAdmin") == "true")
            {
                <span>
                    Send Message
                </span>
            }
            else
            {
                <span>
                    Contact Admin
                </span>
            }

        </a>

    </div>


</div>