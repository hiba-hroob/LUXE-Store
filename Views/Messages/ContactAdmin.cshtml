@{
    ViewData["Title"] = "Contact Admin";
}

<style>

    .contact-page {
        min-height: 85vh;
        padding: 70px 20px;
        background: #F7F1E8;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .contact-card {
        width: 100%;
        max-width: 650px;
        background: #111;
        border: 1px solid #C6A15B;
        border-radius: 28px;
        padding: 45px;
        box-shadow: 0 25px 60px rgba(0,0,0,.3);
        position: relative;
        overflow: hidden;
    }

        .contact-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 160px;
            height: 3px;
            background: #C6A15B;
            box-shadow: 0 0 20px rgba(198,161,91,.7);
        }

    .contact-icon {
        width: 75px;
        height: 75px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #0F2E26;
        border: 1px solid #C6A15B;
        color: #C6A15B;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 30px;
    }

    .contact-title {
        text-align: center;
        color: #C6A15B;
        letter-spacing: 5px;
        margin-bottom: 10px;
    }

    .contact-subtitle {
        text-align: center;
        color: #888;
        margin-bottom: 35px;
    }

    .contact-label {
        display: block;
        color: #C6A15B;
        margin-bottom: 10px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .contact-textarea {
        width: 100%;
        min-height: 180px;
        resize: vertical;
        box-sizing: border-box;
        background: #1A1A1A;
        border: 1px solid #444;
        border-radius: 16px;
        padding: 17px;
        color: white;
        outline: none;
        transition: .3s;
    }

        .contact-textarea:focus {
            border-color: #C6A15B;
            box-shadow: 0 0 15px rgba(198,161,91,.15);
        }

        .contact-textarea::placeholder {
            color: #777;
        }

    .contact-btn {
        width: 100%;
        margin-top: 22px;
        padding: 15px;
        border-radius: 50px;
        border: 1px solid #C6A15B;
        background: #0F2E26;
        color: #C6A15B;
        font-weight: 700;
        letter-spacing: 2px;
        cursor: pointer;
        transition: .35s;
    }

        .contact-btn:hover {
            background: #1A4639;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(198,161,91,.3);
        }

    .back-btn {
        display: block;
        text-align: center;
        margin-top: 18px;
        color: #888;
        text-decoration: none;
        transition: .3s;
    }

        .back-btn:hover {
            color: #C6A15B;
        }

    .error-message {
        text-align: center;
        color: #ff4d6d;
        margin-bottom: 20px;
    }

    @@media(max-width:600px) {

        .contact-card {
            padding: 30px 20px;
        }

        .contact-title {
            font-size: 25px;
        }
    }

</style>


<div class="contact-page">

    <div class="contact-card">

        <div class="contact-icon">
            <i class="fa-solid fa-headset"></i>
        </div>

        <h1 class="contact-title">
            CONTACT ADMIN
        </h1>

        <p class="contact-subtitle">
            We're here to help you with anything you need.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Messages"
              asp-action="ContactAdmin"
              method="post">

            <label class="contact-label">

                <i class="fa-solid fa-message"></i>

                YOUR MESSAGE

            </label>

            <textarea name="content"
                      class="contact-textarea"
                      placeholder="Write your message to the admin..."
                      required></textarea>

            <button type="submit"
                    class="contact-btn">

                <i class="fa-solid fa-paper-plane"></i>

                SEND TO ADMIN

            </button>

        </form>

        <a asp-controller="Messages"
           asp-action="Index"
           class="back-btn">

            <i class="fa-solid fa-arrow-left"></i>

            Back to Messages

        </a>

    </div>

</div>