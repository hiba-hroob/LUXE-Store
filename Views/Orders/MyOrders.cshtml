@model List<Webproject.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<style>

    .orders-page {
        min-height: 100vh;
        padding: 70px 35px;
        background: radial-gradient(circle at top left, rgba(198,161,91,.12), transparent 35%), radial-gradient(circle at bottom right, rgba(15,46,38,.12), transparent 35%), #F7F1E8;
    }

    .orders-wrapper {
        max-width: 1200px;
        margin: auto;
    }

    

    .orders-header {
        text-align: center;
        margin-bottom: 55px;
    }

        .orders-header .header-icon {
            width: 78px;
            height: 78px;
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 24px;
            background: linear-gradient(145deg, #0F2E26, #1A4639);
            color: #C6A15B;
            font-size: 30px;
            box-shadow: 0 15px 35px rgba(15,46,38,.22), inset 0 0 20px rgba(198,161,91,.08);
            transform: rotate(-3deg);
            transition: .4s ease;
        }

            .orders-header .header-icon:hover {
                transform: rotate(0deg) scale(1.08);
                box-shadow: 0 20px 45px rgba(198,161,91,.25);
            }

        .orders-header h1 {
            margin: 0;
            color: #0F2E26;
            font-size: 42px;
            font-weight: 800;
            letter-spacing: 7px;
        }

            .orders-header h1::after {
                content: "";
                display: block;
                width: 75px;
                height: 3px;
                margin: 16px auto 0;
                background: #C6A15B;
                border-radius: 10px;
            }

        .orders-header p {
            margin-top: 15px;
            color: #888;
            font-size: 14px;
            letter-spacing: 2px;
        }



    .orders-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 28px;
    }



    .order-card {
        position: relative;
        padding: 30px;
        border-radius: 28px;
        background: rgba(255,255,255,.72);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(198,161,91,.25);
        box-shadow: 0 15px 45px rgba(15,46,38,.08);
        overflow: hidden;
        transition: transform .45s ease, box-shadow .45s ease, border-color .45s ease;
    }

        .order-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient( 90deg, transparent, #C6A15B, transparent );
        }

        .order-card::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -100px;
            bottom: -100px;
            border-radius: 50%;
            background: rgba(198,161,91,.06);
            pointer-events: none;
        }

        .order-card:hover {
            transform: translateY(-9px);
            border-color: rgba(198,161,91,.65);
            box-shadow: 0 25px 60px rgba(15,46,38,.15), 0 0 30px rgba(198,161,91,.08);
        }

    

    .order-top {
        display: flex;
        align-items: center;
        gap: 16px;
        padding-bottom: 23px;
        border-bottom: 1px solid rgba(15,46,38,.08);
    }

    .order-icon {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #0F2E26;
        color: #C6A15B;
        font-size: 21px;
        box-shadow: 0 10px 25px rgba(15,46,38,.18);
        transition: .4s ease;
    }

    .order-card:hover .order-icon {
        transform: rotate(6deg) scale(1.06);
    }

    .order-top h3 {
        margin: 0;
        color: #0F2E26;
        font-size: 19px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .order-top span {
        display: block;
        margin-top: 7px;
        color: #999;
        font-size: 12px;
        letter-spacing: .5px;
    }

        .order-top span i {
            color: #C6A15B;
            margin-right: 4px;
        }


    .order-price-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 25px 0;
    }

    .price-label {
        color: #999;
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .order-price {
        margin-top: 6px;
        color: #C6A15B;
        font-size: 30px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .order-number-badge {
        padding: 8px 13px;
        border-radius: 30px;
        background: rgba(15,46,38,.07);
        color: #0F2E26;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
    }



    .order-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .order-btn,
    .delete-order-btn {
        min-height: 47px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 13px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .8px;
        text-decoration: none;
        transition: .35s ease;
        box-sizing: border-box;
    }

   

    .order-btn {
        background: #0F2E26;
        color: #C6A15B;
        border: 1px solid #0F2E26;
        position: relative;
        overflow: hidden;
    }

        .order-btn::before {
            content: "";
            position: absolute;
            top: 0;
            left: -120%;
            width: 80%;
            height: 100%;
            background: linear-gradient( 120deg, transparent, rgba(255,255,255,.35), transparent );
            transition: .6s;
        }

        .order-btn:hover::before {
            left: 130%;
        }

        .order-btn:hover {
            color: white;
            background: #1A4639;
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(15,46,38,.2);
        }

 

    .delete-order-form {
        margin: 0;
    }

    .delete-order-btn {
        width: 100%;
        background: transparent;
        color: #b22a3a;
        border: 1px solid rgba(178,42,58,.25);
        cursor: pointer;
    }

        .delete-order-btn:hover {
            background: #b22a3a;
            color: white;
            border-color: #b22a3a;
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(178,42,58,.18);
        }



    .empty-orders {
        padding: 80px 30px;
        text-align: center;
        border-radius: 28px;
        background: rgba(255,255,255,.75);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(198,161,91,.3);
        box-shadow: 0 20px 50px rgba(15,46,38,.08);
    }

        .empty-orders i {
            width: 80px;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 22px;
            border-radius: 50%;
            background: #0F2E26;
            color: #C6A15B;
            font-size: 30px;
        }

        .empty-orders h3 {
            margin: 0;
            color: #0F2E26;
            font-size: 24px;
        }

        .empty-orders p {
            margin-top: 10px;
            color: #888;
            font-size: 14px;
        }

   

    .back-products-btn {
        width: fit-content;
        margin: 45px auto 0;
        padding: 14px 27px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-radius: 14px;
        background: #0F2E26;
        color: #C6A15B;
        border: 1px solid #0F2E26;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        transition: .35s ease;
    }

        .back-products-btn:hover {
            background: #C6A15B;
            color: #0F2E26;
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(198,161,91,.25);
        }


    @@media (max-width: 850px) {

        .orders-page {
            padding: 50px 20px;
        }

        .orders-container {
            grid-template-columns: 1fr;
        }

        .orders-header h1 {
            font-size: 34px;
        }
    }

    @@media (max-width: 500px) {

        .orders-header h1 {
            font-size: 27px;
            letter-spacing: 4px;
        }

        .orders-header p {
            font-size: 12px;
        }

        .order-card {
            padding: 23px;
        }

        .order-actions {
            grid-template-columns: 1fr;
        }

        .order-price {
            font-size: 27px;
        }
    }

</style>

<div class="orders-page">

  
    <div class="orders-wrapper">

  

        <div class="orders-header">

            <div class="header-icon">
                <i class="fa-solid fa-gem"></i>
            </div>

            <h1>
                MY ORDERS
            </h1>

            <p>
                Your luxury shopping history
            </p>

        </div>


        @if (Model != null && Model.Any())
        {

            <div class="orders-container">

                @foreach (var order in Model)
                {

                    <div class="order-card">

                

                        <div class="order-top">

                            <div class="order-icon">

                                <i class="fa-solid fa-box-open"></i>

                            </div>

                            <div>

                                <span>

                                    <i class="fa-regular fa-calendar"></i>

                                    @order.OrderDate.ToString("dd MMM yyyy")

                                </span>

                            </div>

                        </div>


                        <div class="order-price-box">

                            <div>

                                <div class="price-label">
                                    Total Amount
                                </div>

                                <div class="order-price">
                                    $@order.TotalPrice.ToString("N2")
                                </div>

                            </div>


                        </div>


             

                        <div class="order-actions">

                            <a asp-action="Details"
                               asp-route-id="@order.Id"
                               class="order-btn">

                                <i class="fa-solid fa-eye"></i>

                                View Details

                            </a>


                            <form asp-action="Delete"
                                  asp-route-id="@order.Id"
                                  method="post"
                                  class="delete-order-form">

                                <button type="submit"
                                        class="delete-order-btn"
                                        onclick="return confirm('Are you sure you want to delete this order?');">

                                    <i class="fa-solid fa-trash"></i>

                                    Delete

                                </button>

                            </form>

                        </div>

                    </div>

                }

            </div>

        }
        else
        {

            <div class="empty-orders">

                <i class="fa-regular fa-folder-open"></i>

                <h3>
                    No Orders Yet
                </h3>

                <p>
                    Your luxury orders will appear here.
                </p>

            </div>

        }


   
        <a asp-controller="Products"
           asp-action="Index"
           class="back-products-btn">

            <i class="fa-solid fa-arrow-left"></i>

            Back to Products

        </a>

    </div>
  

</div>
