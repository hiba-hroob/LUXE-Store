@model List<Webproject.Models.OrderDetail>

@{
    ViewData["Title"] = "Order Details";
}


<style>

    .order-showcase {
        min-height: 90vh;
        padding: 60px;
        background: #F7F1E8;
    }



    .order-card {
        max-width: 950px;
        margin: auto;
        background: white;
        border-radius: 35px;
        padding: 45px;
        box-shadow: 0 25px 60px rgba(0,0,0,.12);
        border: 1px solid rgba(198,161,91,.35);
    }




    .order-header {
        text-align: center;
        margin-bottom: 45px;
    }


        .order-header i {
            font-size: 45px;
            color: #C6A15B;
        }


        .order-header h1 {
            margin-top: 15px;
            letter-spacing: 7px;
            color: #111;
            font-size: 40px;
        }


        .order-header p {
            color: #888;
            letter-spacing: 2px;
        }





    .order-product {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 25px;
        margin-bottom: 20px;
        border-radius: 20px;
        background: #FDFBF7;
        border: 1px solid rgba(198,161,91,.2);
        transition: .35s;
    }


        .order-product:hover {
            transform: translateX(8px);
            border-color: #C6A15B;
            box-shadow: 0 15px 30px rgba(198,161,91,.15);
        }



    .product-left {
        display: flex;
        align-items: center;
        gap: 25px;
    }


        .product-left img {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 20px;
            border: 1px solid #C6A15B;
        }



    .product-name {
        font-size: 20px;
        color: #111;
        font-weight: 600;
        letter-spacing: 1px;
    }



    .product-label {
        color: #999;
        font-size: 13px;
        margin-top: 8px;
    }



    .product-price {
        color: #C6A15B;
        font-size: 22px;
        font-weight: bold;
    }



   

    .order-summary {
        margin-top: 40px;
        padding-top: 30px;
        border-top: 1px solid #ddd;
        text-align: right;
    }


        .order-summary h2 {
            color: #111;
        }


        .order-summary span {
            color: #C6A15B;
        }






    .order-action {
        text-align: center;
        margin-top: 40px;
    }


    .back-btn {
        display: inline-block;
        width: 320px;
        padding: 16px;
        border-radius: 50px;
        background: #0F2E26;
        color: #C6A15B;
        text-decoration: none;
        border: 1px solid #C6A15B;
        font-weight: 600;
        letter-spacing: 2px;
        position: relative;
        overflow: hidden;
        transition: .4s;
    }


        .back-btn::before {
            content: "";
            position: absolute;
            top: 0;
            left: -120%;
            width: 80%;
            height: 100%;
            background: linear-gradient( 120deg, transparent, rgba(255,255,255,.8), transparent );
            transform: skewX(-25deg);
            transition: .7s;
        }


        .back-btn:hover::before {
            left: 130%;
        }


        .back-btn:hover {
            color: white;
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(198,161,91,.35);
        }

</style>



<div class="order-showcase">


    <div class="order-card">


        <div class="order-header">

            <i class="fa-solid fa-gem"></i>

            <h1>
                ORDER DETAILS
            </h1>

            <p>
                Your LUXE Collection
            </p>

        </div>



        @foreach (var item in Model)
        {

            <div class="order-product">


                <div class="product-left">


                    <img src="@item.Product.ImageUrl" />


                    <div>

                        <div class="product-name">

                            @item.Product.Name

                        </div>


                        <div class="product-label">

                            Premium Beauty Selection

                        </div>

                    </div>


                </div>


                <div class="product-price">

                    @item.Price $

                </div>


            </div>

        }



        <div class="order-summary">

            <h2>

                Total:
                <span>
                    @Model.Sum(x => x.Price) $
                </span>

            </h2>

        </div>



        <div class="order-action">


            <a asp-controller="Orders"
               asp-action="MyOrders"
               class="back-btn">

                <i class="fa-solid fa-arrow-left"></i>

                Back to Orders

            </a>


        </div>


    </div>


</div>