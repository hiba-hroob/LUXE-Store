@model Webproject.Models.User

@{
    ViewData["Title"] = "Sign In";
}

<style>

/* =========================================
   LUXE SIGN IN PAGE
   ========================================= */

.login-page {
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 70px;
    padding: 60px 50px;
    background:
        linear-gradient(
            90deg,
            rgba(8, 8, 8, .96),
            rgba(8, 8, 8, .78)
        ),
        url('/imgs/mmain.jpg');
    background-size: cover;
    background-position: center;
    position: relative;
    overflow: hidden;
}


/* =========================================
   LOGIN CARD
   ========================================= */

.login-container {
    width: 420px;
    padding: 45px;
    background: rgba(255, 255, 255, .08);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    border: 1px solid rgba(198, 161, 91, .3);
    border-radius: 24px;

    box-shadow:
        0 25px 70px rgba(0, 0, 0, .55),
        inset 0 0 30px rgba(255, 255, 255, .025);

    position: relative;
    z-index: 2;

    margin: 0 !important;
    transform: none !important;
}


/* Gold glow around card */

.login-container::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 24px;
    padding: 1px;

    background: linear-gradient(
        135deg,
        rgba(198,161,91,.55),
        transparent 35%,
        transparent 65%,
        rgba(198,161,91,.25)
    );

    -webkit-mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);

    -webkit-mask-composite: xor;
    mask-composite: exclude;

    pointer-events: none;
}


/* =========================================
   TITLE
   ========================================= */

.login-title {
    text-align: center;
    color: white;
    font-size: 38px;
    font-weight: 700;
    letter-spacing: 5px;
    margin-bottom: 35px;
}


/* =========================================
   FORM
   ========================================= */

.form-group {
    margin-bottom: 23px;
}

.form-group label {
    color: #eee;
    display: block;
    margin-bottom: 9px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1.5px;
}


/* =========================================
   INPUT
   ========================================= */

.form-control {
    width: 100%;
    padding: 14px 18px;

    background: rgba(255, 255, 255, .07);
    border: 1px solid rgba(198, 161, 91, .28);
    border-radius: 12px;

    color: white;

    outline: none;

    transition:
        border-color .35s ease,
        box-shadow .35s ease,
        transform .35s ease,
        background .35s ease;
}

.form-control::placeholder {
    color: rgba(255, 255, 255, .45);
}

.form-control:focus {
    border-color: #C6A15B;

    box-shadow:
        0 0 0 3px rgba(198, 161, 91, .08),
        0 0 25px rgba(198, 161, 91, .18);

    background: rgba(255, 255, 255, .1);

    transform: translateY(-2px);
}


/* =========================================
   LOGIN BUTTON
   ========================================= */

.login-button {
    width: 100%;
    padding: 14px;

    margin-top: 10px;

    background: #0F2E26;
    color: #C6A15B;

    border: 1px solid #C6A15B;
    border-radius: 50px;

    font-weight: 600;
    font-size: 13px;
    letter-spacing: 3px;

    position: relative;
    overflow: hidden;

    cursor: pointer;

    transition:
        transform .35s ease,
        background .35s ease,
        color .35s ease,
        box-shadow .35s ease;
}

.login-button::before {
    content: "";

    position: absolute;
    top: 0;
    left: -120%;

    width: 100%;
    height: 100%;

    background: linear-gradient(
        120deg,
        transparent,
        rgba(255,255,255,.7),
        transparent
    );

    transition: .6s ease;
}

.login-button:hover::before {
    left: 120%;
}

.login-button:hover {
    background: #C6A15B;
    color: #111;

    transform: translateY(-4px);

    box-shadow:
        0 15px 35px rgba(198,161,91,.3);
}


/* =========================================
   REGISTER
   ========================================= */

.register-link {
    text-align: center;
    margin-top: 25px;

    color: rgba(255,255,255,.7);
    font-size: 13px;
}

.register-link a {
    color: #C6A15B;
    text-decoration: none;
    font-weight: 600;
    margin-left: 4px;

    transition: color .3s ease;
}

.register-link a:hover {
    color: white;
}


/* =========================================
   ERROR MESSAGE
   ========================================= */

.signin-error {
    background: rgba(180, 40, 40, .12);
    border: 1px solid rgba(255, 80, 80, .45);

    color: #ff9999;

    padding: 11px 14px;

    border-radius: 12px;

    margin-bottom: 20px;

    font-size: 12px;

    display: flex;
    align-items: center;
    gap: 9px;

    text-align: left;
}

.signin-error i {
    color: #ff6b6b;
    font-size: 14px;
}


/* =========================================
   LUXE BRANDING SECTION
   ========================================= */

.luxe-banner {
    width: 550px;
    max-width: 100%;

    padding: 60px 30px;

    text-align: center;

    background: rgba(255,255,255,.025);

    border: 1px solid rgba(198,161,91,.12);

    border-radius: 30px;

    box-shadow:
        inset 0 0 60px rgba(198,161,91,.025);

    position: relative;
    z-index: 1;
}

.luxe-banner > span {
    display: inline-block;

    padding: 8px 20px;

    background: rgba(198,161,91,.12);

    color: #C6A15B;

    backdrop-filter: blur(10px);

    border-radius: 50px;

    font-weight: 600;

    letter-spacing: 2px;

    border: 1px solid rgba(198,161,91,.3);

    margin-bottom: 20px;
}

.luxe-banner h1 {
    font-size: 48px;
    font-weight: 700;

    line-height: 1.15;

    margin: 10px 0 20px;

    color: white;

    letter-spacing: 1px;
}

.luxe-banner p {
    color: #aaa;

    max-width: 500px;

    margin: auto;

    line-height: 1.8;

    font-size: 14px;
}


/* =========================================
   EXPLORE BUTTON
   ========================================= */

.luxe-btn {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    margin-top: 30px;

    padding: 13px 30px;

    border-radius: 50px;

    background: #0F2E26;

    color: #C6A15B;

    font-weight: 600;

    letter-spacing: 1.5px;

    text-decoration: none;

    border: 1px solid #C6A15B;

    transition: .35s ease;
}

.luxe-btn:hover {
    background: #C6A15B;

    color: #111;

    transform: translateY(-4px);

    box-shadow:
        0 12px 30px rgba(198,161,91,.3);
}


/* =========================================
   TABLET
   ========================================= */

@@media (max-width: 1000px) {

    .login-page {
        gap: 35px;
        padding: 50px 25px;
    }

    .login-container {
        width: 380px;
        padding: 38px;
    }

    .luxe-banner {
        width: 480px;
    }

    .luxe-banner h1 {
        font-size: 40px;
    }
}


/* =========================================
   MOBILE
   ========================================= */

@@media (max-width: 800px) {

    .login-page {
        min-height: auto;

        flex-direction: column;

        gap: 30px;

        padding: 45px 18px 60px;
    }

    .login-container {
        width: 100%;
        max-width: 420px;

        padding: 35px 25px;
    }

    .login-title {
        font-size: 32px;
        margin-bottom: 28px;
    }

    .luxe-banner {
        width: 100%;
        max-width: 420px;

        padding: 40px 20px;
    }

    .luxe-banner h1 {
        font-size: 32px;
    }

    .luxe-banner p {
        font-size: 13px;
    }
}


/* =========================================
   SMALL MOBILE
   ========================================= */

@@media (max-width: 480px) {

    .login-page {
        padding: 30px 12px 45px;
        gap: 22px;
    }

    .login-container {
        padding: 30px 20px;
        border-radius: 20px;
    }

    .login-title {
        font-size: 27px;
        letter-spacing: 4px;
    }

    .form-control {
        padding: 13px 15px;
    }

    .login-button {
        padding: 13px;
    }

    .luxe-banner {
        padding: 32px 15px;
        border-radius: 22px;
    }

    .luxe-banner h1 {
        font-size: 28px;
    }

    .luxe-banner p {
        font-size: 12px;
        line-height: 1.7;
    }

    .luxe-btn {
        padding: 11px 22px;
        font-size: 12px;
    }
}
</style>



<div class="login-page">


    <div class="login-container">


        <h2 class="login-title">
            SIGN IN
        </h2>

        @if (ViewBag.Error != null)
        {
            <div class="signin-error">

                <i class="fa-solid fa-circle-exclamation"></i>

                <span>
                    @ViewBag.Error
                </span>

            </div>
        }

        <form asp-controller="Account"
              asp-action="SignIn"
              method="post"
              autocomplete="new-password">

            <div class="form-group">

                <label>
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control"
                       type="email"
                       placeholder="Enter your email"
                       autocomplete="email"
                       required />

            </div>

            <div class="form-group">

                <label>
                    Password
                </label>

                <input asp-for="Password"
                       class="form-control"
                       type="password"
                       placeholder="Enter your password"
                       autocomplete="new-password"
                       required />

            </div>

            <button type="submit" class="login-button">
                LOGIN
            </button>

        </form>


        <div class="register-link">

            Don't have an account?

            <a asp-action="SignUp">
                Register
            </a>


        </div>


    </div>


    
    <section class="luxe-banner">


        <span style="
            display:inline-block;
            padding:8px 20px;
            background:rgba(198,161,91,.15);
            color:#C6A15B;
            backdrop-filter:blur(10px);
            border-radius:50px;
            font-weight:600;
            letter-spacing:2px;
            border:1px solid #111;
            margin-bottom:20px;">

            LUXE COLLECTION

        </span>



        <h1>
            Discover Your <br />
            Signature Beauty
        </h1>



        <p>
            Explore premium skincare, makeup and fragrances
            carefully selected for elegance and confidence.
        </p>



        <a href="#products" class="luxe-btn">
            Explore Collection
        </a>


    </section>

</div>