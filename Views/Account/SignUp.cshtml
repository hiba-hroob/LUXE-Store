@model Webproject.Models.User

@{
    ViewData["Title"] = "Sign Up";
}

<style>

    .login-page {
        min-height: 85vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient( rgba(0,0,0,.65), rgba(0,0,0,.80) ), url('/imgs/mmain.jpg');
        background-size: cover;
        background-position: center;
    }

 
    .login-container {
        width: 420px;
        padding: 45px;
        background: rgba(255,255,255,.12);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255,255,255,.25);
        box-shadow: 0 20px 50px rgba(0,0,0,.5);
        border-radius: 15px;
        position: relative;
        display: block;
        margin-top: 60px !important;
        margin-right: auto !important;
        margin-bottom: 60px !important;
        margin-left: 60px !important;
        transform: none !important;
    }

    .login-title {
        text-align: center;
        color: white;
        font-size: 40px;
        letter-spacing: 5px;
        margin-bottom: 35px;
    }

    .form-group {
        margin-bottom: 25px;
    }

        .form-group label {
            color: white;
            display: block;
            margin-bottom: 8px;
            letter-spacing: 2px;
        }

    .form-control {
        width: 100%;
        padding: 14px 18px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(198,161,91,.3);
        border-radius: 12px;
        color: white;
        transition: all .35s ease;
        backdrop-filter: blur(8px);
    }

        .form-control::placeholder {
            color: rgba(255,255,255,.55);
        }

        .form-control:focus {
            outline: none;
            border-color: #C6A15B;
            box-shadow: 0 0 20px rgba(198,161,91,.35);
            transform: translateY(-3px);
            background: rgba(255,255,255,.12);
            transition: .5s;
        }

    .login-button {
        width: 100%;
        padding: 14px;
        margin-top: 20px;
        background: #111;
        color: #C6A15B;
        border: 1px solid #C6A15B;
        font-weight: bold;
        letter-spacing: 3px;
        position: relative;
        overflow: hidden;
        transition: .4s;
        border-radius: 20px;
    }

        .login-button::before {
            content: "";
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient( 120deg, transparent, rgba(255,255,255,.8), transparent );
            transition: .5s;
        }

        .login-button:hover::before {
            left: 100%;
        }

        .login-button:hover {
            background: #111;
            color: white;
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(198,161,91,.5);
            border: 1px solid #C6A15B;
        }

    .register-link {
        text-align: center;
        margin-top: 25px;
        color: white;
    }

        .register-link a {
            color: #C6A15B;
            text-decoration: none;
            font-weight: bold;
        }

        
    .luxe-banner {
        color: #ddd;
        background-position: center;
        border-radius: 30px;
        padding: 100px 60px;
        margin: 40px auto;
        text-align: center;
    }

        .luxe-banner h1 {
            font-size: 58px;
            font-weight: 700;
            margin-bottom: 20px;
            color: #ddd;
        }

        .luxe-banner p {
            color: #ddd;
            max-width: 650px;
            margin: auto;
            line-height: 1.8;
        }

     
    .luxe-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 35px;
        padding: 16px 45px;
        border-radius: 50px;
        background: rgba(198,161,91,.15);
        color: #C6A15B;
        font-weight: 600;
        letter-spacing: 1px;
        text-decoration: none;
        border: 1px solid #C6A15B;
        position: relative;
        overflow: hidden;
        transition: .5s ease;
    }


      

        .luxe-btn::before {
            content: "";
            position: absolute;
            inset: 0;
            background: #C6A15B;
            transform: translateY(100%);
            transition: .5s ease;
            z-index: -1;
        }


     

        .luxe-btn:hover::before {
            transform: translateY(0);
        }


        .luxe-btn:hover {
            color: white;
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(198,161,91,.35);
        }

    .login-success {
        color: #8fd19e;
        background: rgba(40, 167, 69, .12);
        border: 1px solid rgba(40, 167, 69, .4);
        border-radius: 12px;
        padding: 12px 15px;
        margin-bottom: 20px;
        text-align: center;
        font-size: 13px;
    }

    .login-error {
        color: #ff6b6b;
        background: rgba(255, 70, 70, .12);
        border: 1px solid rgba(255, 70, 70, .4);
        border-radius: 12px;
        padding: 12px 15px;
        margin-bottom: 20px;
        text-align: center;
        font-size: 13px;
    }
</style>

<div class="login-page">

    <div class="login-container">

        <h2 class="login-title">
            SIGN UP
        </h2>

        @if (TempData["Success"] != null)
        {
            <div class="login-success">
                <i class="fa-solid fa-circle-check"></i>
                @TempData["Success"]
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="login-error">
                <i class="fa-solid fa-circle-exclamation"></i>
                @ViewBag.Error
            </div>
        }

        <form asp-action="SignUp" method="post" autocomplete="off">

            <div class="form-group">

                <label>Full Name</label>

                <input asp-for="FullName"
                       class="form-control"
                       type="text"
                       placeholder="Enter your full name"
                       required />

                <span asp-validation-for="FullName" class="text-danger"></span>

            </div>

            <div class="form-group">

                <label>Email</label>
                <input asp-for="Email"
                       class="form-control"
                       type="email"
                       placeholder="Enter your email"
                       autocomplete="new-email"
                       value="" />

                <span asp-validation-for="Email" class="text-danger"></span>

            </div>

            <div class="form-group">

                <label>Password</label>

                <input asp-for="Password"
                       class="form-control"
                       type="password"
                       placeholder="Create your password"
                       autocomplete="new-password"
                       value="" />

                <span asp-validation-for="Password" class="text-danger"></span>

            </div>

            <button type="submit" class="login-button">
                CREATE ACCOUNT
            </button>

        </form>

        <div class="register-link">

            Already have an account?

            <a asp-action="SignIn">
                Sign In
            </a>

        </div>

    </div>

    
    <section class="luxe-banner">


        <span style="
            display:inline-block;
            padding:8px 20px;
            background:rgba(198,161,91,.15);
            color:#C6A15B;
            backdrop-filter:blur(10px);
            border-radius:50px;
            font-weight:600;
            letter-spacing:2px;
            border:1px solid #111;
            margin-bottom:20px;">

            LUXE COLLECTION

        </span>



        <h1>
            Discover Your <br />
            Signature Beauty
        </h1>



        <p>
            Explore premium skincare, makeup and fragrances
            carefully selected for elegance and confidence.
        </p>



        <a href="#products" class="luxe-btn">
            Explore Collection
        </a>


    </section>

</div>