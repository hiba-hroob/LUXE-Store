@{
    ViewData["Title"] = "Security";
}

<style>

    .security-page {
        min-height: 85vh;
        padding: 70px 25px;
        background: radial-gradient(circle at 15% 20%, rgba(198,161,91,.12), transparent 30%), radial-gradient(circle at 85% 80%, rgba(26,70,57,.10), transparent 30%), #F7F1E8;
        display: flex;
        align-items: center;
        justify-content: center;
    }



    .security-panel {
        width: min(950px, 100%);
        min-height: 540px;
        display: grid;
        grid-template-columns: .85fr 1.15fr;
        background: rgba(255,255,255,.72);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(198,161,91,.35);
        border-radius: 32px;
        overflow: hidden;
        box-shadow: 0 30px 80px rgba(15,46,38,.15);
    }

    

    .security-visual {
        position: relative;
        padding: 55px 40px;
        background: #0F2E26;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
    }

        .security-visual::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border: 1px solid rgba(198,161,91,.25);
            border-radius: 50%;
            top: -100px;
            left: -100px;
        }

        .security-visual::after {
            content: "";
            position: absolute;
            width: 380px;
            height: 380px;
            border: 1px solid rgba(198,161,91,.15);
            border-radius: 50%;
            bottom: -220px;
            right: -180px;
        }

    .visual-content {
        position: relative;
        z-index: 2;
    }

    .security-mark {
        width: 75px;
        height: 75px;
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(198,161,91,.10);
        border: 1px solid rgba(198,161,91,.55);
        color: #C6A15B;
        font-size: 30px;
        margin-bottom: 30px;
        box-shadow: 0 0 35px rgba(198,161,91,.12);
    }

    .security-visual h2 {
        color: white;
        font-size: 34px;
        line-height: 1.2;
        margin: 0 0 18px;
        letter-spacing: 1px;
    }

        .security-visual h2 span {
            color: #C6A15B;
        }

    .security-visual p {
        color: rgba(255,255,255,.65);
        line-height: 1.8;
        font-size: 14px;
        max-width: 300px;
        margin: 0;
    }

    .security-note {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 12px;
        color: rgba(255,255,255,.65);
        font-size: 12px;
        letter-spacing: .5px;
    }

        .security-note i {
            color: #C6A15B;
            font-size: 17px;
        }

  
    .security-form-area {
        padding: 55px 60px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .form-heading {
        margin-bottom: 30px;
    }

        .form-heading small {
            color: #C6A15B;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .form-heading h1 {
            margin: 8px 0 0;
            color: #0F2E26;
            font-size: 30px;
            letter-spacing: 1px;
        }

        .form-heading p {
            color: #888;
            font-size: 13px;
            margin-top: 8px;
        }


    .security-field {
        position: relative;
        margin-bottom: 17px;
    }

        .security-field i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #C6A15B;
            font-size: 15px;
            z-index: 2;
        }

    .security-input {
        width: 100%;
        height: 52px;
        padding: 0 45px;
        border-radius: 14px;
        border: 1px solid #e2d8c7;
        background: #fff;
        color: #222;
        outline: none;
        font-size: 13px;
        box-sizing: border-box;
        transition: .3s ease;
    }

        .security-input::placeholder {
            color: #aaa;
        }

        .security-input:focus {
            border-color: #C6A15B;
            box-shadow: 0 0 0 4px rgba(198,161,91,.10);
            background: #fffdf9;
        }

   

    .security-btn {
        width: 100%;
        height: 53px;
        margin-top: 12px;
        border: none;
        border-radius: 14px;
        background: #0F2E26;
        color: #C6A15B;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: .35s ease;
    }

        .security-btn::before {
            content: "";
            position: absolute;
            top: 0;
            left: -120%;
            width: 80%;
            height: 100%;
            background: linear-gradient( 120deg, transparent, rgba(255,255,255,.35), transparent );
            transform: skewX(-25deg);
            transition: .7s ease;
        }

        .security-btn:hover::before {
            left: 130%;
        }

        .security-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(15,46,38,.22);
            color: white;
        }



    .security-status {
        margin-top: 20px;
        padding: 12px 15px;
        border-radius: 12px;
        background: rgba(26,70,57,.06);
        display: flex;
        align-items: center;
        gap: 10px;
        color: #777;
        font-size: 11px;
    }

        .security-status i {
            color: #1A4639;
        }



    @@media (max-width: 800px) {

        .security-panel {
            grid-template-columns: 1fr;
        }

        .security-visual {
            min-height: 300px;
        }

        .security-form-area {
            padding: 40px 30px;
        }
    }

    @@media (max-width: 480px) {

        .security-page {
            padding: 30px 15px;
        }

        .security-visual {
            padding: 40px 25px;
        }

            .security-visual h2 {
                font-size: 28px;
            }

        .security-form-area {
            padding: 35px 22px;
        }
    }

</style>


<div class="security-page">

    <div class="security-panel">

   

        <div class="security-visual">

            <div class="visual-content">

                <div class="security-mark">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>

                <h2>
                    Keep Your<br />
                    <span>Account</span> Secure.
                </h2>

                <p>
                    Protect your LUXE account with a strong,
                    private password. Your security is always
                    part of the experience.
                </p>

            </div>

            <div class="security-note">

                <i class="fa-solid fa-lock"></i>

                <span>
                    Your credentials are kept private.
                </span>

            </div>

        </div>




        <div class="security-form-area">

            <div class="form-heading">

                <small>
                    Account Protection
                </small>

                <h1>
                    Change Password
                </h1>

                <p>
                    Update your password to keep your account protected.
                </p>

            </div>


            <form method="post">

                <div class="security-field">

                    <i class="fa-solid fa-key"></i>

                    <input class="security-input"
                           type="password"
                           name="CurrentPassword"
                           placeholder="Current Password"
                           required />

                </div>


                <div class="security-field">

                    <i class="fa-solid fa-lock"></i>

                    <input class="security-input"
                           type="password"
                           name="NewPassword"
                           placeholder="New Password"
                           required />

                </div>


                <div class="security-field">

                    <i class="fa-solid fa-check"></i>

                    <input class="security-input"
                           type="password"
                           name="ConfirmPassword"
                           placeholder="Confirm New Password"
                           required />

                </div>


                <button type="submit"
                        class="security-btn">

                    UPDATE PASSWORD

                </button>

            </form>


            <div class="security-status">

                <i class="fa-solid fa-circle-check"></i>

                <span>
                    Make sure your new password is something only you know.
                </span>

            </div>

        </div>

    </div>

</div>

