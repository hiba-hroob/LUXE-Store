@model Webproject.Models.User

@{
    ViewData["Title"] = "My Account";
}

<style>

    /* =========================================================
       LUXE ACCOUNT — PREMIUM RESPONSIVE DESIGN
       ========================================================= */

    .luxe-account {
        min-height: 100vh;
        box-sizing: border-box;
        padding: 70px 35px 80px;

        background:
            radial-gradient(circle at top left,
                rgba(198,161,91,.12),
                transparent 35%),
            radial-gradient(circle at bottom right,
                rgba(15,46,38,.18),
                transparent 40%),
            #F7F1E8;

        color: #111;
    }


    .account-wrapper {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
    }


    /* =========================================================
       PROFILE CARD
       ========================================================= */

    .profile-card {
        position: relative;

        width: 100%;
        max-width: 900px;

        margin: 0 auto 45px;
        padding: 38px;

        box-sizing: border-box;

        display: flex;
        align-items: center;
        gap: 30px;

        border-radius: 30px;

        background: rgba(255,255,255,.72);

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        border: 1px solid rgba(198,161,91,.3);

        box-shadow:
            0 20px 55px rgba(15,46,38,.10);

        overflow: hidden;

        transition:
            transform .4s ease,
            box-shadow .4s ease;
    }


    .profile-card::before {
        content: "";

        position: absolute;

        top: 0;
        left: 50%;

        transform: translateX(-50%);

        width: 120px;
        height: 4px;

        background: #C6A15B;

        box-shadow:
            0 0 18px rgba(198,161,91,.7);
    }


    .profile-card:hover {
        transform: translateY(-5px);

        box-shadow:
            0 28px 65px rgba(15,46,38,.14);
    }


    /* =========================================================
       AVATAR
       ========================================================= */

    .profile-avatar {
        width: 115px;
        height: 115px;

        flex: 0 0 115px;

        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        background:
            linear-gradient(
                145deg,
                #0F2E26,
                #1A4639
            );

        color: #C6A15B;

        border: 2px solid #C6A15B;

        font-size: 43px;

        box-shadow:
            0 15px 35px rgba(15,46,38,.20);

        transition:
            transform .4s ease,
            box-shadow .4s ease;
    }


    .profile-card:hover .profile-avatar {
        transform: scale(1.06);

        box-shadow:
            0 18px 40px rgba(198,161,91,.25);
    }


    /* =========================================================
       PROFILE INFORMATION
       ========================================================= */

    .profile-info {
        min-width: 0;
    }


    .profile-info h2 {
        margin: 0;

        color: #0F2E26;

        font-size: 30px;
        font-weight: 800;

        letter-spacing: 2px;

        line-height: 1.2;

        overflow-wrap: anywhere;
    }


    .profile-info p {
        margin: 8px 0 18px;

        color: #888;

        font-size: 14px;
        letter-spacing: .7px;

        overflow-wrap: anywhere;
    }


    .member-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        padding: 9px 17px;

        border-radius: 30px;

        background: #0F2E26;

        color: #C6A15B;

        border: 1px solid rgba(198,161,91,.45);

        font-size: 11px;
        font-weight: 700;

        letter-spacing: 2px;
    }


    .member-badge::before {
        content: "✦";
        color: #C6A15B;
    }


    /* =========================================================
       SECTION TITLE
       ========================================================= */

    .account-section-title {
        text-align: center;

        margin-bottom: 28px;
    }


    .account-section-title small {
        display: block;

        color: #C6A15B;

        font-size: 10px;
        font-weight: 700;

        letter-spacing: 4px;

        text-transform: uppercase;
    }


    .account-section-title h1 {
        margin: 8px 0 0;

        color: #0F2E26;

        font-size: 28px;

        letter-spacing: 3px;

        line-height: 1.2;
    }


    .account-section-title h1::after {
        content: "";

        display: block;

        width: 60px;
        height: 3px;

        margin: 13px auto 0;

        background: #C6A15B;

        border-radius: 10px;
    }


    /* =========================================================
       ACCOUNT GRID
       ========================================================= */

    .account-grid {
        display: grid;

        grid-template-columns:
            repeat(3, minmax(0, 1fr));

        gap: 25px;

        width: 100%;
    }


    /* =========================================================
       ACCOUNT CARDS
       ========================================================= */

    .account-box {
        position: relative;

        width: 100%;
        min-width: 0;
        height: 230px;

        box-sizing: border-box;

        display: flex;
        flex-direction: column;

        justify-content: center;
        align-items: center;

        text-align: center;

        padding: 25px;

        border-radius: 27px;

        background: rgba(255,255,255,.72);

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        border: 1px solid rgba(198,161,91,.28);

        box-shadow:
            0 15px 40px rgba(15,46,38,.08);

        text-decoration: none;

        overflow: hidden;

        transition:
            transform .4s ease,
            box-shadow .4s ease,
            border-color .4s ease;
    }


    .account-box::before {
        content: "";

        position: absolute;

        top: 0;
        left: -120%;

        width: 80%;
        height: 100%;

        background:
            linear-gradient(
                120deg,
                transparent,
                rgba(255,255,255,.7),
                transparent
            );

        transform: skewX(-25deg);

        transition: .7s ease;
    }


    .account-box:hover::before {
        left: 140%;
    }


    .account-box:hover {
        transform: translateY(-9px);

        border-color: #C6A15B;

        box-shadow:
            0 25px 55px rgba(15,46,38,.14),
            0 0 25px rgba(198,161,91,.08);
    }


    /* =========================================================
       GOLD LINE
       ========================================================= */

    .gold-line {
        position: absolute;

        top: 0;
        left: 50%;

        transform: translateX(-50%);

        width: 65px;
        height: 4px;

        background: #C6A15B;

        box-shadow:
            0 0 15px rgba(198,161,91,.7);
    }


    /* =========================================================
       ICON
       ========================================================= */

    .account-box i {
        width: 72px;
        height: 72px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 20px;

        border-radius: 21px;

        background: #0F2E26;

        color: #C6A15B;

        font-size: 30px;

        box-shadow:
            0 12px 28px rgba(15,46,38,.18);

        transition:
            transform .4s ease,
            box-shadow .4s ease;

        z-index: 2;
    }


    .account-box:hover i {
        transform:
            translateY(-5px)
            scale(1.08);

        box-shadow:
            0 15px 35px rgba(198,161,91,.20);
    }


    /* =========================================================
       CARD TEXT
       ========================================================= */

    .account-box h4 {
        margin: 0 0 9px;

        color: #0F2E26;

        font-size: 17px;
        font-weight: 800;

        letter-spacing: 2px;

        z-index: 2;
    }


    .account-box span {
        color: #888;

        font-size: 12px;

        letter-spacing: .5px;

        line-height: 1.5;

        z-index: 2;
    }


    .account-box:hover span {
        color: #666;
    }


    /* =========================================================
       LARGE DESKTOP
       ========================================================= */

    @@media (min-width: 1200px) {

        .luxe-account {
            padding: 70px 50px 80px;
        }

        .account-wrapper {
            max-width: 1100px;
        }

        .profile-card {
            max-width: 900px;
        }

        .account-grid {
            gap: 25px;
        }
    }


    /* =========================================================
       LAPTOP
       ========================================================= */

    @@media (min-width: 992px) and (max-width: 1199px) {

        .luxe-account {
            padding: 55px 35px 70px;
        }

        .account-wrapper {
            max-width: 1000px;
        }

        .profile-card {
            max-width: 850px;
            margin-bottom: 40px;
        }

        .account-grid {
            gap: 20px;
        }
    }


    /* =========================================================
       IPAD / TABLET
       ========================================================= */

    @@media (min-width: 768px) and (max-width: 991px) {

        .luxe-account {
            padding: 45px 28px 60px;
        }

        .account-wrapper {
            max-width: 850px;
        }

        .profile-card {
            max-width: 100%;
            margin-bottom: 35px;
            padding: 30px;
            gap: 24px;
        }

        .profile-avatar {
            width: 100px;
            height: 100px;
            flex-basis: 100px;
            font-size: 37px;
        }

        .profile-info h2 {
            font-size: 27px;
        }

        .account-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
            gap: 20px;
        }

        .account-box {
            height: 215px;
            padding: 22px;
        }
    }


    /* =========================================================
       MOBILE
       ========================================================= */

@@media (max-width: 767px) {

    .luxe-account {
        padding: 40px 14px 55px;
    }

    .profile-card {
        flex-direction: column;
        text-align: center;
        padding: 28px 18px;
        gap: 18px;
    }

    .profile-avatar {
        width: 90px;
        height: 90px;
        font-size: 32px;
    }

    .profile-info h2 {
        font-size: 23px;
    }

    .profile-info p {
        font-size: 13px;
    }

    /* بطاقتين جنب بعض على الموبايل */
    .account-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .account-box {
        height: 175px;
        padding: 15px 8px;
        border-radius: 20px;
    }

    .account-box i {
        width: 52px;
        height: 52px;
        margin-bottom: 12px;
        border-radius: 16px;
        font-size: 22px;
    }

    .account-box h4 {
        font-size: 13px;
        letter-spacing: 1px;
        margin-bottom: 6px;
    }

    .account-box span {
        font-size: 10px;
        line-height: 1.4;
    }

    /* إلغاء حركة البطاقات على الموبايل */
    .account-box:hover {
        transform: none;
    }

    .account-box:hover i {
        transform: none;
    }

    .profile-card:hover {
        transform: none;
    }
}

    /* =========================================================
       SMALL MOBILE
       ========================================================= */

@@media (max-width: 480px) {

    .luxe-account {
        padding: 32px 10px 45px;
    }

    .profile-card {
        padding: 24px 14px;
        gap: 15px;
        border-radius: 24px;
    }

    .profile-avatar {
        width: 78px;
        height: 78px;
        font-size: 28px;
    }

    .profile-info h2 {
        font-size: 20px;
        letter-spacing: 1px;
    }

    .profile-info p {
        font-size: 12px;
        margin: 6px 0 14px;
    }

    .member-badge {
        padding: 7px 12px;
        font-size: 9px;
        letter-spacing: 1.5px;
    }

    .account-section-title {
        margin-bottom: 20px;
    }

    .account-section-title h1 {
        font-size: 23px;
        letter-spacing: 2px;
    }

    /* بطاقتين جنب بعض حتى على الشاشات الصغيرة */
    .account-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .account-box {
        height: 155px;
        padding: 12px 6px;
        border-radius: 18px;
    }

    .account-box i {
        width: 46px;
        height: 46px;
        margin-bottom: 9px;
        border-radius: 14px;
        font-size: 19px;
    }

    .account-box h4 {
        font-size: 11px;
        letter-spacing: 1px;
        margin-bottom: 5px;
    }

    .account-box span {
        font-size: 9px;
        line-height: 1.35;
    }

    .gold-line {
        width: 45px;
        height: 3px;
    }

    .account-box:hover {
        transform: none;
    }

    .account-box:hover i {
        transform: none;
    }

    .profile-card:hover {
        transform: none;
    }
}

@@media (max-width: 360px) {

    .account-box {
        height: 145px;
        border-radius: 16px;
        padding: 10px 5px;
    }

    .account-box i {
        width: 42px;
        height: 42px;
        font-size: 17px;
        margin-bottom: 8px;
    }

    .account-box h4 {
        font-size: 10px;
    }

    .account-box span {
        font-size: 8px;
    }
}




    /* =========================================================
       REDUCED MOTION
       ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        .profile-card,
        .profile-avatar,
        .account-box,
        .account-box i,
        .account-box::before {
            transition: none !important;
        }
    }

</style>


<div class="luxe-account">

    <div class="account-wrapper">

        <div class="profile-card">

            <div class="profile-avatar">
                <i class="fa-solid fa-user"></i>
            </div>

            <div class="profile-info">

                <h2>
                    @Model.FullName
                </h2>

                <p>
                    @Model.Email
                </p>

                <span class="member-badge">
                    LUXE MEMBER
                </span>

            </div>

        </div>


        <div class="account-section-title">

            <small>
                Personal Space
            </small>

            <h1>
                MY ACCOUNT
            </h1>

        </div>


        <div class="account-grid">

            <a asp-controller="Favorites"
               asp-action="Index"
               class="account-box">

                <div class="gold-line"></div>

                <i class="fa-solid fa-heart"></i>

                <h4>
                    FAVORITES
                </h4>

                <span>
                    Your saved luxury products
                </span>

            </a>


            <a asp-controller="Wallet"
               asp-action="Index"
               class="account-box">

                <div class="gold-line"></div>

                <i class="fa-solid fa-wallet"></i>

                <h4>
                    WALLET
                </h4>

                <span>
                    Balance & Transactions
                </span>

            </a>


            <a asp-controller="Account"
               asp-action="ChangePassword"
               class="account-box">

                <div class="gold-line"></div>

                <i class="fa-solid fa-shield-halved"></i>

                <h4>
                    SECURITY
                </h4>

                <span>
                    Protect your account
                </span>

            </a>

        </div>

    </div>

</div>

