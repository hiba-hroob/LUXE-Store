
@model Webproject.Models.User

@{
    ViewData["Title"] = "My Account";
}

<style>
    /* =========================================================
       LUXE ACCOUNT — PREMIUM RESPONSIVE DESIGN
       ========================================================= */

    .luxe-account {
        min-height: 100vh;
        box-sizing: border-box;
        padding: 70px 35px 80px;
        background:
            radial-gradient(circle at top left, rgba(198,161,91,.12), transparent 35%),
            radial-gradient(circle at bottom right, rgba(15,46,38,.18), transparent 40%),
            #F7F1E8;
        color: #111;
    }

    .account-wrapper {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
    }

    /* PROFILE CARD */

    .profile-card {
        position: relative;
        width: 100%;
        max-width: 900px;
        margin: 0 auto 45px;
        padding: 38px;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: 30px;
        border-radius: 30px;
        background: rgba(255,255,255,.72);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(198,161,91,.3);
        box-shadow: 0 20px 55px rgba(15,46,38,.10);
        overflow: hidden;
        transition: transform .4s ease, box-shadow .4s ease;
    }

    .profile-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 120px;
        height: 4px;
        background: #C6A15B;
        box-shadow: 0 0 18px rgba(198,161,91,.7);
    }

    .profile-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 28px 65px rgba(15,46,38,.14);
    }

    /* AVATAR */

    .profile-avatar {
        width: 115px;
        height: 115px;
        flex: 0 0 115px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(145deg, #0F2E26, #1A4639);
        color: #C6A15B;
        border: 2px solid #C6A15B;
        font-size: 43px;
        box-shadow: 0 15px 35px rgba(15,46,38,.20);
        transition: transform .4s ease, box-shadow .4s ease;
    }

    .profile-card:hover .profile-avatar {
        transform: scale(1.06);
        box-shadow: 0 18px 40px rgba(198,161,91,.25);
    }

    /* PROFILE INFORMATION */

    .profile-info {
        min-width: 0;
    }

    .profile-info h2 {
        margin: 0;
        color: #0F2E26;
        font-size: 30px;
        font-weight: 800;
        letter-spacing: 2px;
        line-height: 1.2;
        overflow-wrap: anywhere;
    }

    .profile-info p {
        margin: 8px 0 18px;
        color: #888;
        font-size: 14px;
        letter-spacing: .7px;
        overflow-wrap: anywhere;
    }

    .member-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 17px;
        border-radius: 30px;
        background: #0F2E26;
        color: #C6A15B;
        border: 1px solid rgba(198,161,91,.45);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .member-badge::before {
        content: "✦";
        color: #C6A15B;
    }

    /* SECTION TITLE */

    .account-section-title {
        text-align: center;
        margin-bottom: 28px;
    }

    .account-section-title small {
        display: block;
        color: #C6A15B;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 4px;
        text-transform: uppercase;
    }

    .account-section-title h1 {
        margin: 8px 0 0;
        color: #0F2E26;
        font-size: 28px;
        letter-spacing: 3px;
        line-height: 1.2;
    }

    .account-section-title h1::after {
        content: "";
        display: block;
        width: 60px;
        height: 3px;
        margin: 13px auto 0;
        background: #C6A15B;
        border-radius: 10px;
    }

    /* ACCOUNT GRID */

    .account-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 25px;
        width: 100%;
    }

    /* ACCOUNT CARDS */

    .account-box {
        position: relative;
        width: 100%;
        min-width: 0;
        height: 230px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 25px;
        border-radius: 27px;
        background: rgba(255,255,255,.72);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(198,161,91,.28);
        box-shadow: 0 15px 40px rgba(15,46,38,.08);
        text-decoration: none;
        overflow: hidden;
        transition:
            transform .4s ease,
            box-shadow .4s ease,
            border-color .4s ease;
    }

    .account-box::before {
        content: "";
        position: absolute;
        top: 0;
        left: -120%;
        width: 80%;
        height: 100%;
        background: linear-gradient(
            120deg,
            transparent,
            rgba(255,255,255,.7),
            transparent
        );
        transform: skewX(-25deg);
        transition: .7s ease;
    }

    .account-box:hover::before {
        left: 140%;
    }

    .account-box:hover {
        transform: translateY(-9px);
        border-color: #C6A15B;
        box-shadow:
            0 25px 55px rgba(15,46,38,.14),
            0 0 25px rgba(198,161,91,.08);
    }

    /* GOLD LINE */

    .gold-line {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 65px;
        height: 4px;
        background: #C6A15B;
        box-shadow: 0 0 15px rgba(198,161,91,.7);
    }

    /* ICON */

    .account-box i {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        border-radius: 21px;
        background: #0F2E26;
        color: #C6A15B;
        font-size: 30px;
        box-shadow: 0 12px 28px rgba(15,46,38,.18);
        transition: transform .4s ease, box-shadow .4s ease;
        z-index: 2;
    }

    .account-box:hover i {
        transform: translateY(-5px) scale(1.08);
        box-shadow: 0 15px 35px rgba(198,161,91,.20);
    }

    /* CARD TEXT */

    .account-box h4 {
        margin: 0 0 9px;
        color: #0F2E26;
        font-size: 17px;
        font-weight: 800;
        letter-spacing: 2px;
        z-index: 2;
    }

    .account-box span {
        color: #888;
        font-size: 12px;
        letter-spacing: .5px;
        line-height: 1.5;
        z-index: 2;
    }

    .account-box:hover span {
        color: #666;
    }

    /* =========================================
       LUXE ACCOUNT — RESPONSIVE REFINEMENT
    ========================================= */
    /* Large desktop */
    @@media (min-width: 1200px) {
        .luxe-account {
            padding: 70px 50px 80px;
        }

        .account-wrapper {
            max-width: 1100px;
        }

        .profile-card {
            max-width: 900px;
        }
    }

    /* Laptop */
    @@media (min-width: 992px) and (max-width: 1199px) {
        .luxe-account {
            padding: 55px 32px 70px;
        }

        .account-wrapper {
            max-width: 1000px;
        }

        .account-grid {
            gap: 20px;
        }

        .account-box {
            padding: 22px 16px;
        }

            .account-box h4 {
                font-size: 15px;
                letter-spacing: 1.5px;
            }

            .account-box span {
                max-width: 100%;
            }
    }

    /* Tablet */
    @@media (min-width: 768px) and (max-width: 991px) {
        .luxe-account {
            padding: 42px 26px 60px;
        }

        .profile-card {
            max-width: 100%;
            margin-bottom: 35px;
            padding: 28px;
            gap: 22px;
        }

        .profile-avatar {
            width: 92px;
            height: 92px;
            flex-basis: 92px;
            font-size: 34px;
        }

        .profile-info h2 {
            font-size: 26px;
            letter-spacing: 1.5px;
        }

        .profile-info p {
            font-size: 13px;
            overflow-wrap: anywhere;
        }

        .account-section-title h1 {
            font-size: 26px;
        }

        .account-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .account-box {
            height: 205px;
            padding: 22px 15px;
        }

            .account-box i {
                width: 62px;
                height: 62px;
                font-size: 26px;
                margin-bottom: 15px;
            }

            .account-box h4 {
                font-size: 15px;
                letter-spacing: 1.5px;
            }

            .account-box span {
                font-size: 11px;
            }

            .account-box:hover {
                transform: translateY(-4px);
            }
    }

    /* Mobile */
    @@media (max-width: 767px) {
        .luxe-account {
            min-height: 100vh;
            padding: 32px 16px 45px;
        }

        .account-wrapper {
            width: 100%;
            max-width: 520px;
        }

        .profile-card {
            width: 100%;
            max-width: none;
            margin-bottom: 34px;
            padding: 27px 20px;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 15px;
            border-radius: 24px;
        }

        .profile-avatar {
            width: 82px;
            height: 82px;
            flex: 0 0 82px;
            font-size: 29px;
        }

        .profile-info {
            width: 100%;
        }

            .profile-info h2 {
                font-size: 22px;
                line-height: 1.4;
                letter-spacing: 1px;
                overflow-wrap: anywhere;
            }

            .profile-info p {
                margin: 7px 0 15px;
                font-size: 12px;
                line-height: 1.6;
                overflow-wrap: anywhere;
            }

        .member-badge {
            padding: 8px 13px;
            font-size: 9px;
            letter-spacing: 1.5px;
        }

        .account-section-title {
            margin-bottom: 23px;
        }

            .account-section-title small {
                font-size: 9px;
                letter-spacing: 3px;
            }

            .account-section-title h1 {
                margin-top: 8px;
                font-size: 24px;
                letter-spacing: 2px;
            }
        /* Stack account cards vertically on mobile */
        .account-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 16px;
        }

        .account-box {
            width: 100%;
            min-width: 0;
            height: 175px;
            padding: 20px;
            border-radius: 19px;
        }

            .account-box i {
                width: 49px;
                height: 49px;
                flex-shrink: 0;
                margin-bottom: 12px;
                border-radius: 15px;
                font-size: 21px;
            }

            .account-box h4 {
                font-size: 12px;
                letter-spacing: .8px;
                line-height: 1.4;
                overflow-wrap: anywhere;
            }

            .account-box span {
                max-width: 100%;
                font-size: 10px;
                letter-spacing: 0;
                line-height: 1.5;
                overflow-wrap: anywhere;
            }
            /* Avoid hover movement on touch screens */
            .profile-card:hover,
            .account-box:hover,
            .profile-card:hover .profile-avatar,
            .account-box:hover i {
                transform: none;
            }

            .account-box:hover {
                box-shadow: 0 15px 40px rgba(15,46,38,.08);
            }
    }

    /* Small phones */
    @@media (max-width: 400px) {
        .luxe-account {
            padding: 27px 12px 38px;
        }

        .profile-card {
            margin-bottom: 29px;
            padding: 23px 14px;
            gap: 13px;
            border-radius: 21px;
        }

        .profile-avatar {
            width: 72px;
            height: 72px;
            flex-basis: 72px;
            font-size: 26px;
        }

        .profile-info h2 {
            font-size: 20px;
        }

        .profile-info p {
            font-size: 11px;
        }

        .member-badge {
            padding: 7px 11px;
            font-size: 8px;
        }

        .account-section-title h1 {
            font-size: 22px;
            letter-spacing: 1.5px;
        }

        .account-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 13px;
        }

        .account-box {
            width: 100%;
            height: 160px;
            padding: 16px 12px;
            border-radius: 17px;
        }

            .account-box i {
                width: 43px;
                height: 43px;
                margin-bottom: 9px;
                font-size: 18px;
                border-radius: 13px;
            }

            .account-box h4 {
                font-size: 11px;
            }

            .account-box span {
                font-size: 9px;
                line-height: 1.4;
            }

        .gold-line {
            width: 45px;
            height: 3px;
        }
    }

    /* Extra-small phones */
    @@media (max-width: 340px) {
        .luxe-account {
            padding-right: 9px;
            padding-left: 9px;
        }

        .account-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 12px;
        }

        .account-box {
            width: 100%;
            height: 155px;
            padding: 16px 12px;
        }

            .account-box h4 {
                font-size: 10px;
                letter-spacing: .5px;
            }

            .account-box span {
                font-size: 8px;
            }
    }

    /* Reduced motion accessibility */
    @@media (prefers-reduced-motion: reduce) {
        .profile-card,
        .profile-avatar,
        .account-box,
        .account-box i,
        .account-box::before {
            transition: none !important;
        }
    }

    
</style>

<div class="luxe-account">

    <div class="account-wrapper">

        <div class="profile-card">

            <div class="profile-avatar">
                <i class="fa-solid fa-user"></i>
            </div>

            <div class="profile-info">

                <h2>
                    @Model.FullName
                </h2>

                <p>
                    @Model.Email
                </p>

                <span class="member-badge">
                    LUXE MEMBER
                </span>

            </div>

        </div>

        <div class="account-section-title">

            <small>
                Personal Space
            </small>

            <h1>
                MY ACCOUNT
            </h1>

        </div>

        <div class="account-grid">

            <a asp-controller="Favorites"
               asp-action="Index"
               class="account-box">

                <div class="gold-line"></div>

                <i class="fa-solid fa-heart"></i>

                <h4>
                    FAVORITES
                </h4>

                <span>
                    Your saved luxury products
                </span>

            </a>

            <a asp-controller="Wallet"
               asp-action="Index"
               class="account-box">

                <div class="gold-line"></div>

                <i class="fa-solid fa-wallet"></i>

                <h4>
                    WALLET
                </h4>

                <span>
                    Balance & Transactions
                </span>

            </a>

            <a asp-controller="Account"
               asp-action="ChangePassword"
               class="account-box">

                <div class="gold-line"></div>

                <i class="fa-solid fa-shield-halved"></i>

                <h4>
                    SECURITY
                </h4>

                <span>
                    Protect your account
                </span>

            </a>

        </div>

    </div>

</div>
