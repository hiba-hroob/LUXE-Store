@model Webproject.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<style>

    .admin-create-page {
        min-height: 100vh;
        padding: 65px 25px;
        background: radial-gradient(circle at 10% 15%, rgba(198,161,91,.12), transparent 28%), radial-gradient(circle at 90% 85%, rgba(15,46,38,.10), transparent 30%), #F7F1E8;
    }

    .admin-create-wrapper {
        max-width: 1050px;
        margin: auto;
    }

  

    .admin-create-header {
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .admin-icon {
        width: 62px;
        height: 62px;
        flex-shrink: 0;
        border-radius: 20px;
        background: #0F2E26;
        color: #C6A15B;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        box-shadow: 0 12px 30px rgba(15,46,38,.18);
    }

    .admin-create-header small {
        color: #C6A15B;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
    }

    .admin-create-header h1 {
        margin: 5px 0 0;
        color: #0F2E26;
        font-size: 32px;
        letter-spacing: 1px;
    }

    .header-description {
        color: #888;
        font-size: 13px;
        margin-top: 5px;
    }

    .admin-label {
        padding: 8px 14px;
        border-radius: 30px;
        background: rgba(15,46,38,.07);
        border: 1px solid rgba(15,46,38,.12);
        color: #0F2E26;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        white-space: nowrap;
    }

    

    .admin-form-card {
        display: grid;
        grid-template-columns: 300px 1fr;
        background: rgba(255,255,255,.82);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(198,161,91,.30);
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 30px 70px rgba(15,46,38,.12);
    }

   

    .product-side {
        position: relative;
        padding: 40px 30px;
        background: #0F2E26;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .product-side::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            border: 1px solid rgba(198,161,91,.20);
            border-radius: 50%;
            top: -150px;
            left: -150px;
        }

        .product-side::after {
            content: "";
            position: absolute;
            width: 360px;
            height: 360px;
            border: 1px solid rgba(198,161,91,.12);
            border-radius: 50%;
            bottom: -230px;
            right: -210px;
        }

    .side-content {
        position: relative;
        z-index: 2;
    }

    .side-icon {
        width: 70px;
        height: 70px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #C6A15B;
        border: 1px solid rgba(198,161,91,.45);
        background: rgba(198,161,91,.08);
        font-size: 27px;
        margin-bottom: 25px;
    }

    .product-side h2 {
        color: white;
        font-size: 27px;
        line-height: 1.25;
        margin: 0 0 15px;
    }

        .product-side h2 span {
            color: #C6A15B;
        }

    .product-side p {
        color: rgba(255,255,255,.62);
        font-size: 13px;
        line-height: 1.8;
        margin: 0;
    }

    .side-info {
        position: relative;
        z-index: 2;
        border-top: 1px solid rgba(255,255,255,.12);
        padding-top: 20px;
    }

    .side-info-row {
        display: flex;
        align-items: center;
        gap: 10px;
        color: rgba(255,255,255,.65);
        font-size: 11px;
        margin-bottom: 12px;
    }

        .side-info-row i {
            color: #C6A15B;
            width: 18px;
            text-align: center;
        }

  

    .product-form {
        padding: 42px 45px;
    }

    .form-title {
        margin-bottom: 28px;
    }

        .form-title small {
            color: #C6A15B;
            font-size: 10px;
            letter-spacing: 2px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .form-title h2 {
            color: #0F2E26;
            margin: 6px 0 0;
            font-size: 23px;
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .admin-field {
        margin-bottom: 19px;
    }

        .admin-field label {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 8px;
            color: #0F2E26;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

            .admin-field label i {
                color: #C6A15B;
                font-size: 12px;
            }

        .admin-field input,
        .admin-field textarea,
        .admin-field select {
            width: 100%;
            box-sizing: border-box;
            border: 1px solid #e4ddd2;
            border-radius: 13px;
            padding: 13px 15px;
            background: #fcfbf8;
            color: #222;
            outline: none;
            font-size: 13px;
            transition: .3s ease;
        }

        .admin-field input {
            height: 48px;
        }

        .admin-field textarea {
            min-height: 110px;
            resize: vertical;
        }

            .admin-field input::placeholder,
            .admin-field textarea::placeholder {
                color: #aaa;
            }

            .admin-field input:focus,
            .admin-field textarea:focus,
            .admin-field select:focus {
                background: white;
                border-color: #C6A15B;
                box-shadow: 0 0 0 4px rgba(198,161,91,.10);
            }



    .admin-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        margin-top: 10px;
        padding-top: 22px;
        border-top: 1px solid #eee;
    }

    .admin-back-btn,
    .admin-add-btn {
        min-height: 46px;
        padding: 0 23px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .7px;
        text-decoration: none;
        transition: .3s ease;
        box-sizing: border-box;
    }

    .admin-back-btn {
        color: #0F2E26;
        border: 1px solid #0F2E26;
        background: transparent;
    }

        .admin-back-btn:hover {
            background: #0F2E26;
            color: white;
            transform: translateY(-2px);
        }

    .admin-add-btn {
        border: 1px solid #0F2E26;
        background: #0F2E26;
        color: #C6A15B;
        cursor: pointer;
    }

        .admin-add-btn:hover {
            background: #1A4639;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(15,46,38,.20);
        }

   

    @@media (max-width: 850px) {

        .admin-form-card {
            grid-template-columns: 1fr;
        }

        .product-side {
            min-height: 300px;
        }

        .product-form {
            padding: 35px 28px;
        }
    }

    @@media (max-width: 650px) {

        .admin-create-page {
            padding: 40px 15px;
        }

        .admin-create-header {
            align-items: flex-start;
        }

        .admin-label {
            display: none;
        }

        .header-left {
            align-items: flex-start;
        }

        .admin-create-header h1 {
            font-size: 26px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .product-side {
            padding: 35px 25px;
        }

        .product-form {
            padding: 30px 20px;
        }

        .admin-actions {
            flex-direction: column-reverse;
        }

        .admin-back-btn,
        .admin-add-btn {
            width: 100%;
        }
    }

</style>


<div class="admin-create-page">

    <div class="admin-create-wrapper">

     

        <div class="admin-create-header">

            <div class="header-left">

                <div class="admin-icon">
                    <i class="fa-solid fa-plus"></i>
                </div>

                <div>

                    <small>
                        LUXE Administration
                    </small>

                    <h1>
                        Add New Product
                    </h1>

                    <div class="header-description">
                        Create a new piece for your luxury collection.
                    </div>

                </div>

            </div>

            <div class="admin-label">
                PRODUCT MANAGEMENT
            </div>

        </div>




        <div class="admin-form-card">

 

            <div class="product-side">

                <div class="side-content">

                    <div class="side-icon">
                        <i class="fa-solid fa-gem"></i>
                    </div>

                    <h2>
                        Create Something
                        <span>Exceptional.</span>
                    </h2>

                    <p>
                        Add a new product to the LUXE collection
                        and make it part of your premium shopping
                        experience.
                    </p>

                </div>

                <div class="side-info">

                    <div class="side-info-row">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Premium product catalog</span>
                    </div>

                    <div class="side-info-row">
                        <i class="fa-solid fa-image"></i>
                        <span>High-quality product imagery</span>
                    </div>

                    <div class="side-info-row">
                        <i class="fa-solid fa-tags"></i>
                        <span>Organized categories & brands</span>
                    </div>

                </div>

            </div>




            <div class="product-form">

                <div class="form-title">

                    <small>
                        Product Details
                    </small>

                    <h2>
                        Product Information
                    </h2>

                </div>


                <form asp-action="Create" method="post">

                    <div class="form-row">

                        <div class="admin-field">

                            <label>
                                <i class="fa-solid fa-tag"></i>
                                Name
                            </label>

                            <input asp-for="Name"
                                   placeholder="Product name" />

                        </div>


                        <div class="admin-field">

                            <label>
                                <i class="fa-solid fa-crown"></i>
                                Brand
                            </label>

                            <input asp-for="Brand"
                                   placeholder="Brand name" />

                        </div>

                    </div>


                    <div class="form-row">

                        <div class="admin-field">

                            <label>
                                <i class="fa-solid fa-layer-group"></i>
                                Category
                            </label>

                            <input asp-for="Category"
                                   placeholder="Rings, Necklaces, Watches..." />

                        </div>


                        <div class="admin-field">

                            <label>
                                <i class="fa-solid fa-dollar-sign"></i>
                                Price
                            </label>

                            <input asp-for="Price"
                                   type="number"
                                   step="0.01"
                                   placeholder="0.00" />

                        </div>

                    </div>


                    <div class="admin-field">

                        <label>
                            <i class="fa-solid fa-image"></i>
                            Image URL
                        </label>

                        <input asp-for="ImageUrl"
                               placeholder="/imgs/product.jpg" />

                    </div>


                    <div class="admin-field">

                        <label>
                            <i class="fa-solid fa-align-left"></i>
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  placeholder="Write a short description about the product..."></textarea>

                    </div>


                    <div class="admin-actions">

                        <a asp-controller="Products"
                           asp-action="Index"
                           class="admin-back-btn">

                            <i class="fa-solid fa-arrow-left"></i>
                            Back

                        </a>


                        <a asp-controller="AdminProducts"
                           asp-action="Index"
                           class="admin-back-btn">

                            <i class="fa-solid fa-arrow-left"></i>
                            Manage Products
                        </a>



                        <button type="submit"
                                class="admin-add-btn">

                            <i class="fa-solid fa-plus"></i>
                            Add Product

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


