@model IEnumerable<Webproject.Models.Product>

@{
    ViewData["Title"] = "Product Management";
}

<style>
    .admin-products-page {
        min-height: 100vh;
        padding: 60px 25px;
        background: radial-gradient(circle at 10% 15%, rgba(198,161,91,.12), transparent 28%), radial-gradient(circle at 90% 85%, rgba(15,46,38,.10), transparent 30%), #F7F1E8;
    }

    .admin-products-wrapper {
        max-width: 1200px;
        margin: auto;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 35px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .admin-icon {
        width: 62px;
        height: 62px;
        border-radius: 20px;
        background: #0F2E26;
        color: #C6A15B;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        box-shadow: 0 12px 30px rgba(15,46,38,.18);
    }

    .admin-header small {
        color: #C6A15B;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
    }

    .admin-header h1 {
        margin: 5px 0 0;
        color: #0F2E26;
        font-size: 32px;
    }

    .header-description {
        color: #888;
        font-size: 13px;
        margin-top: 5px;
    }

    .add-product-btn {
        background: #0F2E26;
        color: #C6A15B;
        border: 1px solid #0F2E26;
        padding: 13px 22px;
        border-radius: 13px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: .3s ease;
    }

        .add-product-btn:hover {
            background: #1A4639;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(15,46,38,.20);
        }

    .products-card {
        background: rgba(255,255,255,.85);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(198,161,91,.30);
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 30px 70px rgba(15,46,38,.12);
    }

    .products-card-header {
        padding: 25px 30px;
        border-bottom: 1px solid #eee;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .products-card-header h2 {
            margin: 0;
            color: #0F2E26;
            font-size: 21px;
        }

    .product-count {
        color: #C6A15B;
        font-weight: bold;
        font-size: 13px;
    }

    .products-table-wrapper {
        overflow-x: auto;
    }

    .products-table {
        width: 100%;
        border-collapse: collapse;
    }

        .products-table th {
            background: #0F2E26;
            color: #C6A15B;
            padding: 16px;
            text-align: left;
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .products-table td {
            padding: 16px;
            border-bottom: 1px solid #eee;
            color: #333;
            font-size: 13px;
        }

        .products-table tr:hover {
            background: rgba(198,161,91,.05);
        }

    .product-img {
        width: 65px;
        height: 65px;
        object-fit: cover;
        border-radius: 14px;
        border: 1px solid #e5dccd;
    }

    .product-name {
        color: #0F2E26;
        font-weight: 700;
    }

    .brand {
        color: #888;
    }

    .category-badge {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        background: rgba(15,46,38,.08);
        color: #0F2E26;
        font-size: 11px;
        font-weight: 700;
    }

    .price {
        color: #C6A15B;
        font-weight: bold;
        font-size: 16px;
    }

    .delete-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 13px;
        border-radius: 10px;
        background: #fff;
        color: #b00020;
        border: 1px solid #b00020;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        transition: .3s ease;
    }

        .delete-btn:hover {
            background: #b00020;
            color: white;
            transform: translateY(-2px);
        }

    .empty-products {
        text-align: center;
        padding: 70px 20px;
        color: #888;
    }

        .empty-products i {
            font-size: 45px;
            color: #C6A15B;
            margin-bottom: 15px;
        }

    @@media (max-width: 700px) {

        .admin-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .products-card-header {
            padding: 20px;
        }

        .admin-header h1 {
            font-size: 26px;
        }
    }
</style>


<div class="admin-products-page">

    <div class="admin-products-wrapper">

        <!-- HEADER -->

        <div class="admin-header">

            <div class="header-left">

                <div class="admin-icon">
                    <i class="fa-solid fa-gem"></i>
                </div>

                <div>

                    <small>
                        LUXE Administration
                    </small>

                    <h1>
                        Product Management
                    </h1>

                    <div class="header-description">
                        Manage your luxury product collection.
                    </div>

                </div>

            </div>


            <a asp-controller="AdminProducts"
               asp-action="Create"
               class="add-product-btn">

                <i class="fa-solid fa-plus"></i>
                Add New Product

            </a>

        </div>


        <!-- PRODUCTS -->

        <div class="products-card">

            <div class="products-card-header">

                <h2>
                    Product Collection
                </h2>

                <span class="product-count">
                    @(Model?.Count() ?? 0) Products
                </span>

            </div>


            @if (Model != null && Model.Any())
            {

                <div class="products-table-wrapper">

                    <table class="products-table">

                        <thead>

                            <tr>

                                <th>Image</th>

                                <th>Name</th>

                                <th>Brand</th>

                                <th>Category</th>

                                <th>Price</th>

                                <th>Action</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var product in Model)
                            {

                                <tr>

                                    <td>

                                        <img src="@(string.IsNullOrEmpty(product.ImageUrl)
                                                                                                ? "/images/default.jpg"
                                                                                                : product.ImageUrl)"
                                             class="product-img"
                                             alt="@product.Name" />

                                    </td>


                                    <td>

                                        <span class="product-name">
                                            @product.Name
                                        </span>

                                    </td>


                                    <td>

                                        <span class="brand">
                                            @product.Brand
                                        </span>

                                    </td>


                                    <td>

                                        <span class="category-badge">
                                            @product.Category
                                        </span>

                                    </td>


                                    <td>

                                        <span class="price">
                                            $@product.Price
                                        </span>

                                    </td>


                                    <td>

                                        <a asp-controller="AdminProducts"
                                           asp-action="Delete"
                                           asp-route-id="@product.Id"
                                           class="delete-btn"
                                           onclick="return confirm('Are you sure you want to delete this product?');">

                                            <i class="fa-solid fa-trash"></i>
                                            Delete

                                        </a>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="empty-products">

                    <i class="fa-solid fa-box-open"></i>

                    <h3>
                        No Products Yet
                    </h3>

                    <p>
                        Start by adding your first luxury product.
                    </p>

                </div>

            }

        </div>

    </div>

</div>