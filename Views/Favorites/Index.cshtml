@model List<Webproject.Models.Favorite>

@{
    ViewData["Title"] = "Favorites";
}

<style>
    .favorites-page {
        padding: 50px;
        min-height: 80vh;
    }

    .favorites-header {
        text-align: center;
        margin-bottom: 45px;
    }

        .favorites-header i {
            color: #C6A15B;
            font-size: 38px;
            margin-bottom: 12px;
        }

        .favorites-header h1 {
            color: #C6A15B;
            letter-spacing: 5px;
            margin: 0;
        }

        .favorites-header p {
            color: #777;
            margin-top: 10px;
        }

    .favorites-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    .favorite-card {
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(198,161,91,.35);
        border-radius: 16px;
        overflow: hidden;
        transition: .35s;
        box-shadow: 0 10px 30px rgba(0,0,0,.2);
    }

        .favorite-card:hover {
            transform: translateY(-8px);
            border-color: #C6A15B;
            box-shadow: 0 15px 35px rgba(198,161,91,.3);
        }

    .favorite-image {
        height: 230px;
        position: relative;
        overflow: hidden;
        background: #111;
    }

        .favorite-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .favorite-heart {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(15,46,38,.9);
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .favorite-heart i {
            color: #d90429;
        }

    .favorite-info {
        padding: 22px;
    }

    .favorite-brand {
        color: #C6A15B;
        font-size: 13px;
        letter-spacing: 2px;
    }

    .favorite-info h3 {
        color: white;
        margin: 8px 0;
    }

    .favorite-info p {  
        color: #999;
        font-size: 14px;
    }

    .favorite-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
    }

    .favorite-price {
        color: #C6A15B;
        font-size: 20px;
        font-weight: bold;
    }

    .remove-favorite {
        width: 40px;
        height: 40px;
        border: 1px solid rgba(217,4,41,.5);
        background: transparent;
        color: #d90429;
        border-radius: 50%;
        cursor: pointer;
        transition: .3s;
    }

        .remove-favorite:hover {
            background: #d90429;
            color: white;
        }

    .empty-favorites {
        text-align: center;
        padding: 80px 20px;
    }

        .empty-favorites > i {
            color: #C6A15B;
            font-size: 70px;
            margin-bottom: 20px;
        }

        .empty-favorites h2 {
            color: #C6A15B;
        }

        .empty-favorites p {
            color: #888;
        }

    .favorites-shop-btn {
        display: inline-block;
        margin-top: 20px;
        padding: 12px 28px;
        background: #0F2E26;
        color: #C6A15B;
        border: 1px solid #C6A15B;
        border-radius: 8px;
        text-decoration: none;
        transition: .3s;
    }

        .favorites-shop-btn:hover {
            background: #C6A15B;
            color: #0F2E26;
        }

    @@media (max-width: 900px) {
        .favorites-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .favorites-grid {
            grid-template-columns: 1fr;
        }

        .favorites-page {
            padding: 25px;
        }
    }

    </style>

<div class="favorites-page">

    <div class="favorites-header">

        <i class="fa-solid fa-heart"></i>

        <h1>MY FAVORITES</h1>

        <p>Your saved luxury products</p>

    </div>

    @if (Model != null && Model.Any())
    {
        <div class="favorites-grid">

            @foreach (var favorite in Model)
            {
                <div class="favorite-card">

                    <div class="favorite-image">

                        @if (!string.IsNullOrEmpty(favorite.Product.ImageUrl))
                        {
                            <img src="@favorite.Product.ImageUrl"
                                 alt="@favorite.Product.Name" />
                        }

                        <div class="favorite-heart">
                            <i class="fa-solid fa-heart"></i>
                        </div>

                    </div>

                    <div class="favorite-info">

                        <span class="favorite-brand">
                            @favorite.Product.Brand
                        </span>

                        <h3>
                            @favorite.Product.Name
                        </h3>

                        <p>
                            @favorite.Product.Description
                        </p>

                        <div class="favorite-bottom">

                            <span class="favorite-price">
                                $@favorite.Product.Price
                            </span>

                            <button type="button"
                                    class="remove-favorite"
                                    data-product-id="@favorite.ProductId">

                                <i class="fa-solid fa-trash"></i>

                            </button>

                        </div>

                    </div>

                </div>
            }

        </div>
    }


    else
    {
        <div class="empty-favorites">

            <i class="fa-regular fa-heart"></i>

            <h2>No Favorites Yet</h2>

            <p>
                You haven't saved any products yet.
            </p>

            <a asp-controller="Products"
               asp-action="Index"
               class="favorites-shop-btn">

                Explore Products

            </a>


        </div>
    }

</div>

</style>

<script>
    document.querySelectorAll(".remove-favorite").forEach(button => {

        button.addEventListener("click", async function() {

            const productId = this.dataset.productId;

            try {

                const formData = new FormData();
                formData.append("productId", productId);

                const response = await fetch("/Favorites/Remove", {
                    method: "POST",
                    body: formData
                });

                const result = await response.json();

                if (result.success) {

                    const card = this.closest(".favorite-card");

                    if (card) {
                        card.remove();
                    }

                   
                    const grid = document.querySelector(".favorites-grid");

                    if (grid && grid.children.length === 0) {
                        location.reload();
                    }
                }

            } catch (error) {

                console.error("Remove favorite error:", error);

            }

        });

    });
</script>
