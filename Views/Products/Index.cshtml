<!-- =========================================================
     LUXE HERO
     ========================================================= -->

<div class="container">

    <section class="luxe-banner">

        <span>
            LUXE COLLECTION
        </span>

        <h1>
            Discover Your <br />
            Signature Beauty
        </h1>

        <p>
            Explore premium skincare, makeup and fragrances
            carefully selected for elegance and confidence.
        </p>

        <a href="#products" class="luxe-btn">
            Explore Collection
        </a>

    </section>


    <!-- =====================================================
         SHOP CONTROLS
         ===================================================== -->

    <div class="shop-controls" id="products">

        <div class="shop-heading">

            <h2>
                Our Collection
            </h2>

            <p>
                Discover luxury products from the world's best brands.
            </p>

        </div>


        <div class="shop-actions">

            <form method="get"
                  asp-action="Index"
                  class="search-form">

                <input type="text"
                       name="searchString"
                       value="@Model.SearchString"
                       placeholder="Search products..."
                       class="search-input" />

                <button type="submit"
                        class="search-btn">
                    Search
                </button>

            </form>


            @if (Context.Session.GetInt32("UserId") != null)
            {
                <a asp-controller="Cart"
                   asp-action="Index"
                   class="cart-icon-link">

                    <i class="fas fa-shopping-cart"></i>

                    <span class="cart-number">
                        @(Context.Session.GetInt32("CartCount") ?? 0)
                    </span>

                </a>
            }

        </div>

    </div>


    <!-- =====================================================
         BRANDS + PRODUCTS
         ===================================================== -->

    @foreach (var brandGroup in Model.GroupedProducts)
    {

        <div class="brand-divider">

            <span class="brand-title">
                @brandGroup.Key
            </span>

        </div>


        <div class="products-slider-container">

            <button class="slider-btn left-btn"
                    type="button">
                ❮
            </button>


            <div class="products-grid"
                 id="slider-@brandGroup.Key">

                @foreach (var product in brandGroup.Value.Take(10))
                {

                    <div class="product-card">

                        @{
                            var favoriteProductIds =
                                ViewBag.FavoriteProductIds as List<int>
                                ?? new List<int>();

                            var isFavorite =
                                favoriteProductIds.Contains(product.Id);
                        }


                        <!-- FAVORITE -->

                        <button type="button"
                                class="favorite-btn @(isFavorite ? "liked" : "")"
                                data-product-id="@product.Id">

                            <i class="@(isFavorite ? "fa-solid" : "fa-regular") fa-heart"></i>

                        </button>


                        <!-- BADGE -->

                        <div class="badge">

                            BEST
                            <br />
                            SELLER

                        </div>


                        <!-- IMAGE -->

                        <div class="product-image">

                            <img src="@(string.IsNullOrEmpty(product.ImageUrl)
                                                        ? "/images/default.jpg"
                                                        : product.ImageUrl)"
                                 class="product-img"
                                 alt="@product.Name" />

                        </div>


                        <!-- CONTENT -->

                        <div class="card-content">

                            <div class="stars">
                                ★★★★★
                            </div>

                            <h5 class="product-name">
                                @product.Name
                            </h5>

                            <p class="product-description">
                                @product.Description
                            </p>

                            <div class="price">
                                $@product.Price
                            </div>

                            <a class="cart-btn"
                               asp-controller="Cart"
                               asp-action="AddToCart"
                               asp-route-id="@product.Id">

                                🛒 Add to Cart

                            </a>

                        </div>

                    </div>

                }

            </div>


            <button class="slider-btn right-btn"
                    type="button">
                ❯
            </button>

        </div>

    }

</div>


<!-- =========================================================
     FAVORITES SCRIPT
     ========================================================= -->

<script>

    document
        .querySelectorAll(".favorite-btn")
        .forEach(button => {

            button.addEventListener("click", async function () {

                const productId =
                    this.dataset.productId;

                const isLiked =
                    this.classList.contains("liked");

                const url =
                    isLiked
                        ? "/Favorites/Remove"
                        : "/Favorites/Add";

                const formData =
                    new FormData();

                formData.append(
                    "productId",
                    productId
                );

                try {

                    const response =
                        await fetch(url, {
                            method: "POST",
                            body: formData
                        });

                    const result =
                        await response.json();


                    if (result.loginRequired) {

                        window.location.href =
                            "/Account/SignIn";

                        return;
                    }


                    if (result.success) {

                        const icon =
                            this.querySelector("i");


                        if (result.liked) {

                            this.classList.add("liked");

                            icon.classList.remove(
                                "fa-regular"
                            );

                            icon.classList.add(
                                "fa-solid"
                            );

                        }
                        else {

                            this.classList.remove("liked");

                            icon.classList.remove(
                                "fa-solid"
                            );

                            icon.classList.add(
                                "fa-regular"
                            );

                        }

                    }

                }
                catch (error) {

                    console.error(
                        "Favorite error:",
                        error
                    );

                }

            });

        });

</script>


<!-- =========================================================
     PRODUCT SLIDER SCRIPT
     ========================================================= -->

<script>

    document
        .querySelectorAll(".products-slider-container")
        .forEach(container => {

            const slider =
                container.querySelector(".products-grid");

            const right =
                container.querySelector(".right-btn");

            const left =
                container.querySelector(".left-btn");


            right.addEventListener("click", function () {

                slider.scrollLeft += 300;

            });


            left.addEventListener("click", function () {

                slider.scrollLeft -= 300;

            });

        });

</script>