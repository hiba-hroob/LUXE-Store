@using System.Linq
@model Webproject.Models.ProductIndexViewModel

@{
    ViewData["Title"] = "LUXE";
}


  
    <style >
        
        body {
            background: #080808;
            font-family: 'Poppins', sans-serif;
            color: white;
        }

        .container {
            max-width: 1400px;
            margin: auto;
        }



        .luxe-banner {
            background: linear-gradient(rgba(0,0,0,.62), rgba(0,0,0,.72)), url('/imgs/mmain.jpg');
            background-size: cover;
            background-position: center;
            border-radius: 32px;
            padding: 110px 60px;
            margin: 40px auto;
            text-align: center;
            border: 1px solid rgba(198,161,91,.25);
            box-shadow: 0 25px 70px rgba(0,0,0,.5), inset 0 0 60px rgba(198,161,91,.06);
        }

            .luxe-banner h1 {
                font-size: 58px;
                font-weight: 700;
                line-height: 1.15;
                margin-bottom: 20px;
                color: white;
                letter-spacing: 1px;
            }

            .luxe-banner p {
                color: #ddd;
                max-width: 650px;
                margin: auto;
                line-height: 1.8;
                font-size: 15px;
            }


        

        .luxe-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-top: 35px;
            padding: 16px 45px;
            border-radius: 50px;
            background: rgba(198,161,91,.12);
            color: #C6A15B;
            font-weight: 600;
            letter-spacing: 1px;
            text-decoration: none;
            border: 1px solid #C6A15B;
            position: relative;
            overflow: hidden;
            transition: .5s ease;
            z-index: 1;
        }

            .luxe-btn::before {
                content: "";
                position: absolute;
                inset: 0;
                background: #C6A15B;
                transform: translateY(100%);
                transition: .5s ease;
                z-index: -1;
            }

            .luxe-btn:hover::before {
                transform: translateY(0);
            }

            .luxe-btn:hover {
                color: #111;
                transform: translateY(-5px);
                box-shadow: 0 15px 35px rgba(198,161,91,.35);
            }


     

        .shop-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 60px 40px 35px;
            gap: 20px;
            flex-wrap: wrap;
        }

            .shop-controls h2 {
                font-size: 34px;
                margin-bottom: 8px;
                color: white;
            }

            .shop-controls p {
                color: #777;
                margin: 0;
            }



        .search-input {
            width: 320px;
            padding: 14px 22px;
            border: 1px solid rgba(198,161,91,.25);
            outline: none;
            border-radius: 50px;
            background: #fff;
            color: #111;
            transition: .3s ease;
        }

            .search-input:focus {
                border-color: #C6A15B;
                box-shadow: 0 0 20px rgba(198,161,91,.15);
            }

        .search-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 35px;
            border-radius: 50px;
            background: rgba(198,161,91,.12);
            color: #C6A15B;
            font-weight: 600;
            letter-spacing: 1px;
            border: 1px solid #C6A15B;
            cursor: pointer;
            transition: .4s ease;
        }

            .search-btn:hover {
                background: #C6A15B;
                color: #111;
                transform: translateY(-3px);
                box-shadow: 0 12px 28px rgba(198,161,91,.3);
            }


     
        .cart-icon-link {
            position: relative;
            color: #C6A15B;
            font-size: 28px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: .35s ease;
        }

            .cart-icon-link:hover {
                color: white;
                transform: translateY(-5px);
                text-shadow: 0 0 15px #C6A15B;
            }

        .cart-number {
            position: absolute;
            top: -10px;
            right: -12px;
            background: #d90429;
            color: white;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            font-size: 11px;
            font-weight: bold;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 12px rgba(217,4,41,.6);
        }


      

        .brand-divider {
            margin: 70px 0 35px;
            text-align: center;
        }

        .brand-title {
            font-size: 32px;
            font-weight: bold;
            color: white;
            letter-spacing: 2px;
            position: relative;
        }

            .brand-title::after {
                content: "";
                width: 80px;
                height: 3px;
                background: #C6A15B;
                display: block;
                margin: 15px auto;
                box-shadow: 0 0 12px rgba(198,161,91,.5);
            }



        .products-slider-container {
            position: relative;
            padding: 20px 70px;
        }

        .products-grid {
            display: flex;
            gap: 30px;
            overflow-x: hidden;
            scroll-behavior: smooth;
            padding: 10px 5px 30px;
        }



        .slider-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #111;
            color: #C6A15B;
            border: 1px solid #C6A15B;
            font-size: 23px;
            cursor: pointer;
            z-index: 10;
            transition: .35s ease;
        }

            .slider-btn:hover {
                background: #C6A15B;
                color: #111;
                transform: translateY(-50%) scale(1.08);
                box-shadow: 0 0 20px rgba(198,161,91,.35);
            }

        .left-btn {
            left: 15px;
        }

        .right-btn {
            right: 15px;
        }



        .product-card {
            position: relative;
            min-width: 280px;
            flex: 0 0 280px;
            height: 485px;
            background: linear-gradient( 145deg, #ffffff, #f5f1ea );
            border: 1px solid rgba(198,161,91,.25);
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0,0,0,.15), inset 0 0 0 1px rgba(255,255,255,.6);
            transition: transform .45s ease, box-shadow .45s ease, border-color .45s ease;
        }

            .product-card:hover {
                transform: translateY(-9px);
                border-color: rgba(198,161,91,.8);
                box-shadow: 0 28px 65px rgba(0,0,0,.25), 0 0 35px rgba(198,161,91,.18);
            }


          

            .product-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: -130%;
                width: 70%;
                height: 100%;
                background: linear-gradient( 110deg, transparent, rgba(255,255,255,.45), transparent );
                transform: skewX(-20deg);
                transition: .8s ease;
                z-index: 15;
                pointer-events: none;
            }

            .product-card:hover::before {
                left: 140%;
            }


       

        .product-image {
            position: relative;
            height: 265px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: radial-gradient( circle at center, #ffffff 0%, #f4efe7 70%, #e7dfd3 100% );
        }

            .product-image::after {
                content: "";
                position: absolute;
                left: 15%;
                right: 15%;
                bottom: 10px;
                height: 25px;
                background: rgba(0,0,0,.13);
                filter: blur(18px);
                border-radius: 50%;
            }

        .product-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .7s ease, filter .5s ease;
        }

        .product-card:hover .product-img {
            transform: scale(1.08);
        }


       

        .favorite-btn {
            position: absolute;
            top: 16px;
            right: 16px;
            width: 44px;
            height: 44px;
            padding: 0;
            border-radius: 50%;
            border: 1px solid rgba(198,161,91,.35);
            background: rgba(255,255,255,.8) !important;
            backdrop-filter: blur(12px);
            color: #777;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 20px;
            cursor: pointer;
            z-index: 30;
            box-shadow: 0 8px 20px rgba(0,0,0,.12);
            transition: transform .3s ease, background .3s ease, box-shadow .3s ease;
        }

            .favorite-btn:hover {
                transform: scale(1.12);
                background: #111 !important;
                box-shadow: 0 8px 25px rgba(198,161,91,.35);
            }

            .favorite-btn i {
                transition: .3s ease;
            }

            .favorite-btn:hover i {
                color: #C6A15B;
            }

            .favorite-btn.liked i {
                color: #d90429;
            }



        .product-card .badge {
            position: absolute;
            top: 18px;
            left: 18px;
            z-index: 20;
            padding: 7px 12px;
            border-radius: 20px;
            background: #111;
            color: #C6A15B;
            border: 1px solid rgba(198,161,91,.5);
            font-size: 9px;
            line-height: 1.2;
            letter-spacing: 1px;
            text-align: center;
            box-shadow: 0 8px 20px rgba(0,0,0,.2);
        }




        .card-content {
            padding: 18px 22px 24px;
            text-align: center;
        }


      

        .stars {
            color: #C6A15B;
            font-size: 13px;
            letter-spacing: 3px;
            margin-bottom: 7px;
        }


       

        .product-name {
            font-size: 20px;
            font-weight: 700;
            margin: 8px 0;
            color: #111;
            letter-spacing: .4px;
        }



        .product-description {
            color: #777;
            font-size: 13px;
            line-height: 1.6;
            margin: 8px auto;
            max-width: 230px;
            opacity: 1;
            max-height: 45px;
            overflow: hidden;
            transform: none;
            transition: .4s ease;
        }


  

        .price {
            color: #C6A15B;
            font-size: 23px;
            font-weight: 700;
            margin-top: 12px;
            opacity: 1;
            max-height: 50px;
            transform: none;
            overflow: visible;
        }


        

        .cart-btn {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 13px 20px;
            margin-top: 16px;
            border-radius: 50px;
            background: #1A4639;
            color: #C6A15B !important;
            border: 1px solid #C6A15B;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 1px;
            overflow: hidden;
            transition: transform .3s ease, background .3s ease, box-shadow .3s ease;
        }

            .cart-btn::before {
                content: "";
                position: absolute;
                top: 0;
                left: -120%;
                width: 80%;
                height: 100%;
                background: linear-gradient( 120deg, transparent, rgba(255,255,255,.75), transparent );
                transition: .6s ease;
            }

            .cart-btn:hover::before {
                left: 130%;
            }

            .cart-btn:hover {
                background: #0F2E26;
                color: #C6A15B !important;
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(26,70,57,.35);
            }


       
        .cart-icon {
            position: relative;
            color: #C6A15B;
            font-size: 32px;
            text-decoration: none;
            transition: .3s;
        }

            .cart-icon:hover {
                color: white;
            }

        .cart-count {
            position: absolute;
            top: -8px;
            right: -10px;
            background: red;
            color: white;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 12px;
            font-weight: bold;
        }


       

        @@media (max-width: 900px) {

            .luxe-banner {
                padding: 80px 30px;
            }

                .luxe-banner h1 {
                    font-size: 45px;
                }

            .shop-controls {
                margin-left: 20px;
                margin-right: 20px;
            }

            .search-input {
                width: 240px;
            }
        }


        @@media (max-width: 700px) {

            .luxe-banner {
                padding: 70px 20px;
                border-radius: 24px;
            }

                .luxe-banner h1 {
                    font-size: 34px;
                }

            .products-slider-container {
                padding: 20px 50px;
            }

            .product-card {
                min-width: 250px;
                flex: 0 0 250px;
                height: 450px;
            }

            .product-image {
                height: 245px;
            }

            .product-name {
                font-size: 18px;
            }

            .search-input {
                width: 100%;
            }

            .shop-controls {
                flex-direction: column;
                align-items: stretch;
            }
        }

</style>




<div class="container" style="max-width:1400px; margin:auto;">


    <section class="luxe-banner">


        <span style="
            display:inline-block;
            padding:8px 20px;
            background:rgba(198,161,91,.15);
            color:#C6A15B;
            backdrop-filter:blur(10px);
            border-radius:50px;
            font-weight:600;
            letter-spacing:2px;
            border:1px solid #111;
            margin-bottom:20px;">

            LUXE COLLECTION

        </span>



        <h1>
            Discover Your <br />
            Signature Beauty
        </h1>



        <p>
            Explore premium skincare, makeup and fragrances
            carefully selected for elegance and confidence.
        </p>



        <a href="#products" class="luxe-btn">
            Explore Collection
        </a>


    </section>





    <div class="shop-controls" id="products">


        <div>

            <h2>
                Our Collection
            </h2>


            <p style="color:#777;">
                Discover luxury products from the world's best brands.
            </p>

        </div>





        <form method="get" asp-action="Index">


            <div style="display:flex; align-items:center; gap:15px;">

                <form method="get" asp-action="Index">

                    <input type="text"
                           name="searchString"
                           value="@Model.SearchString"
                           placeholder="Search products..."
                           class="search-input" />

                    <button class="search-btn">
                        Search
                    </button>

                </form>

                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <a asp-controller="Cart" asp-action="Index" class="cart-icon-link"> 
                        <i class="fas fa-shopping-cart"></i> 
                        <span class="cart-number"> @(Context.Session.GetInt32("CartCount") ?? 0) </span> 
                        </a>
                }

            </div>

            


        </form>


    </div>







    @foreach (var brandGroup in Model.GroupedProducts)
    {


        <div class="brand-divider">


            <span class="brand-title">

                @brandGroup.Key

            </span>


        </div>





        <div class="products-slider-container">


            <button class="slider-btn left-btn">
                ❮
            </button>





            <div class="products-grid" id="slider-@brandGroup.Key">





                @foreach (var product in brandGroup.Value.Take(10))
                {



                    <div class="product-card">





                        @{
                            var favoriteProductIds = ViewBag.FavoriteProductIds as List<int> ?? new List<int>();
                            var isFavorite = favoriteProductIds.Contains(product.Id);
                        }

                        <button type="button"
                                class="favorite-btn @(isFavorite ? "liked" : "")"
                                data-product-id="@product.Id">

                          
                            <i class="@(isFavorite ? "fa-solid" : "fa-regular") fa-heart"></i>
                      

                        </button>






                        <div class="badge">

                            BEST
                            <br />
                            SELLER

                        </div>





                        <div class="product-image">


                            <img src="@(string.IsNullOrEmpty(product.ImageUrl)
                                                                ? "/images/default.jpg"
                                                                : product.ImageUrl)"
                                 class="product-img"
                                 alt="@product.Name" />


                        </div>








                        <div class="card-content">





                            <div class="stars">

                                ★★★★★

                            </div>






                            <h5 class="product-name">

                                @product.Name

                            </h5>







                            <p class="product-description">

                                @product.Description

                            </p>







                            <div class="price">

                                $@product.Price

                            </div>







                            <a class="cart-btn"
                               asp-controller="Cart"
                               asp-action="AddToCart"
                               asp-route-id="@product.Id">


                                🛒 Add to Cart


                            </a>



                        </div>


                    </div>



                }


            </div>





            <button class="slider-btn right-btn">
                ❯
            </button>




        </div>



    }



</div>
<script>

    document.querySelectorAll(".favorite-btn").forEach(button => {

        button.addEventListener("click", async function() {

            const productId = this.dataset.productId;
            const isLiked = this.classList.contains("liked");

            const url = isLiked
                ? "/Favorites/Remove"
                : "/Favorites/Add";

            const formData = new FormData();

            formData.append("productId", productId);

            try {

                const response = await fetch(url, {
                    method: "POST",
                    body: formData
                });

                const result = await response.json();

                if (result.loginRequired) {
                    window.location.href = "/Account/SignIn";
                    return;
                }

                if (result.success) {

                    const icon = this.querySelector("i");

                    if (result.liked) {

                        this.classList.add("liked");

                        icon.classList.remove("fa-regular");
                        icon.classList.add("fa-solid");

                    } else {

                        this.classList.remove("liked");

                        icon.classList.remove("fa-solid");
                        icon.classList.add("fa-regular");

                    }

                }

            } catch (error) {

                console.error("Favorite error:", error);

            }

        });

    });

</script>

<script>

    document.querySelectorAll(".products-slider-container").forEach(container => {

        let slider = container.querySelector(".products-grid");

        let right = container.querySelector(".right-btn");
        let left = container.querySelector(".left-btn");


        right.addEventListener("click", function() {

            slider.scrollLeft += 300;

        });


        left.addEventListener("click", function() {

            slider.scrollLeft -= 300;

        });


    });

</script>