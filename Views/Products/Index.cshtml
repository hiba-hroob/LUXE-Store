@using System.Linq
@model Webproject.Models.ProductIndexViewModel

@{
    ViewData["Title"] = "LUXE";
}

<style>

    /* =========================================================
       LUXE PRODUCTS PAGE
       ========================================================= */

    body {
        background: #080808;
        font-family: 'Poppins', sans-serif;
        color: white;
    }

    .container {
        max-width: 1400px;
        margin: auto;
    }


    /* =========================================================
       LUXE HERO BANNER
       ========================================================= */

    .luxe-banner {
        background:
            linear-gradient(rgba(0,0,0,.62), rgba(0,0,0,.72)),
            url('/imgs/mmain.jpg');

        background-size: cover;
        background-position: center;

        border-radius: 32px;
        padding: 110px 60px;
        margin: 40px auto;

        text-align: center;

        border: 1px solid rgba(198,161,91,.25);

        box-shadow:
            0 25px 70px rgba(0,0,0,.5),
            inset 0 0 60px rgba(198,161,91,.06);
    }

    .luxe-banner span {
        display: inline-block;
        padding: 8px 20px;

        background: rgba(198,161,91,.15);
        color: #C6A15B;

        backdrop-filter: blur(10px);

        border-radius: 50px;

        font-weight: 600;
        letter-spacing: 2px;

        border: 1px solid #111;

        margin-bottom: 20px;
    }

    .luxe-banner h1 {
        font-size: 58px;
        font-weight: 700;
        line-height: 1.15;

        margin-bottom: 20px;

        color: white;
        letter-spacing: 1px;
    }

    .luxe-banner p {
        color: #ddd;
        max-width: 650px;

        margin: auto;

        line-height: 1.8;
        font-size: 15px;
    }


    /* =========================================================
       LUXE BUTTON
       ========================================================= */

    .luxe-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        margin-top: 35px;

        padding: 16px 45px;

        border-radius: 50px;

        background: rgba(198,161,91,.12);

        color: #C6A15B;

        font-weight: 600;
        letter-spacing: 1px;

        text-decoration: none;

        border: 1px solid #C6A15B;

        position: relative;
        overflow: hidden;

        transition: .5s ease;

        z-index: 1;
    }

    .luxe-btn::before {
        content: "";

        position: absolute;
        inset: 0;

        background: #C6A15B;

        transform: translateY(100%);

        transition: .5s ease;

        z-index: -1;
    }

    .luxe-btn:hover::before {
        transform: translateY(0);
    }

    .luxe-btn:hover {
        color: #111;

        transform: translateY(-5px);

        box-shadow:
            0 15px 35px rgba(198,161,91,.35);
    }


    /* =========================================================
       SHOP CONTROLS
       ========================================================= */

    .shop-controls {
        display: flex;

        justify-content: space-between;
        align-items: center;

        margin: 60px 40px 35px;

        gap: 30px;

        flex-wrap: wrap;
    }

    .shop-heading h2 {
        font-size: 34px;

        margin-bottom: 8px;

        color: white;
    }

    .shop-heading p {
        color: #777;

        margin: 0;

        font-size: 14px;
    }

    .shop-actions {
        display: flex;

        align-items: center;

        gap: 15px;
    }


    /* =========================================================
       SEARCH
       ========================================================= */

    .search-form {
        display: flex;

        align-items: center;

        gap: 12px;
    }

    .search-input {
        width: 320px;

        padding: 14px 22px;

        border: 1px solid rgba(198,161,91,.25);

        outline: none;

        border-radius: 50px;

        background: #fff;

        color: #111;

        transition: .3s ease;
    }

    .search-input::placeholder {
        color: #888;
    }

    .search-input:focus {
        border-color: #C6A15B;

        box-shadow:
            0 0 20px rgba(198,161,91,.15);
    }

    .search-btn {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        padding: 14px 30px;

        border-radius: 50px;

        background: rgba(198,161,91,.12);

        color: #C6A15B;

        font-weight: 600;

        letter-spacing: 1px;

        border: 1px solid #C6A15B;

        cursor: pointer;

        transition: .4s ease;
    }

    .search-btn:hover {
        background: #C6A15B;

        color: #111;

        transform: translateY(-3px);

        box-shadow:
            0 12px 28px rgba(198,161,91,.3);
    }


    /* =========================================================
       CART ICON
       ========================================================= */

    .cart-icon-link {
        position: relative;

        color: #C6A15B;

        font-size: 28px;

        text-decoration: none;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        width: 48px;
        height: 48px;

        transition: .35s ease;
    }

    .cart-icon-link:hover {
        color: white;

        transform: translateY(-5px);

        text-shadow:
            0 0 15px #C6A15B;
    }

    .cart-number {
        position: absolute;

        top: -3px;
        right: -4px;

        background: #d90429;

        color: white;

        width: 20px;
        height: 20px;

        border-radius: 50%;

        font-size: 11px;

        font-weight: bold;

        display: flex;

        justify-content: center;
        align-items: center;

        box-shadow:
            0 0 12px rgba(217,4,41,.6);
    }


    /* =========================================================
       BRAND TITLE
       ========================================================= */

    .brand-divider {
        margin: 70px 0 35px;

        text-align: center;
    }

    .brand-title {
        font-size: 32px;

        font-weight: bold;

        color: white;

        letter-spacing: 2px;

        position: relative;
    }

    .brand-title::after {
        content: "";

        width: 80px;
        height: 3px;

        background: #C6A15B;

        display: block;

        margin: 15px auto;

        box-shadow:
            0 0 12px rgba(198,161,91,.5);
    }


    /* =========================================================
       PRODUCTS SLIDER
       ========================================================= */

    .products-slider-container {
        position: relative;

        padding: 20px 70px;
    }

    .products-grid {
        display: flex;

        gap: 30px;

        overflow-x: hidden;

        scroll-behavior: smooth;

        padding: 10px 5px 30px;
    }


    /* =========================================================
       SLIDER BUTTONS
       ========================================================= */

    .slider-btn {
        position: absolute;

        top: 50%;

        transform: translateY(-50%);

        width: 48px;
        height: 48px;

        border-radius: 50%;

        background: #111;

        color: #C6A15B;

        border: 1px solid #C6A15B;

        font-size: 23px;

        cursor: pointer;

        z-index: 10;

        transition: .35s ease;
    }

    .slider-btn:hover {
        background: #C6A15B;

        color: #111;

        transform:
            translateY(-50%)
            scale(1.08);

        box-shadow:
            0 0 20px rgba(198,161,91,.35);
    }

    .left-btn {
        left: 15px;
    }

    .right-btn {
        right: 15px;
    }


    /* =========================================================
       PRODUCT CARD
       ========================================================= */

    .product-card {
        position: relative;

        min-width: 280px;

        flex: 0 0 280px;

        height: 485px;

        background:
            linear-gradient(
                145deg,
                #ffffff,
                #f5f1ea
            );

        border: 1px solid rgba(198,161,91,.25);

        border-radius: 28px;

        overflow: hidden;

        box-shadow:
            0 15px 35px rgba(0,0,0,.15),
            inset 0 0 0 1px rgba(255,255,255,.6);

        transition:
            transform .45s ease,
            box-shadow .45s ease,
            border-color .45s ease;
    }

    .product-card:hover {
        transform: translateY(-9px);

        border-color:
            rgba(198,161,91,.8);

        box-shadow:
            0 28px 65px rgba(0,0,0,.25),
            0 0 35px rgba(198,161,91,.18);
    }

    .product-card::before {
        content: "";

        position: absolute;

        top: 0;
        left: -130%;

        width: 70%;
        height: 100%;

        background:
            linear-gradient(
                110deg,
                transparent,
                rgba(255,255,255,.45),
                transparent
            );

        transform: skewX(-20deg);

        transition: .8s ease;

        z-index: 15;

        pointer-events: none;
    }

    .product-card:hover::before {
        left: 140%;
    }


    /* =========================================================
       PRODUCT IMAGE
       ========================================================= */

    .product-image {
        position: relative;

        height: 265px;
        width: 100%;

        display: flex;

        align-items: center;
        justify-content: center;

        overflow: hidden;

        background:
            radial-gradient(
                circle at center,
                #ffffff 0%,
                #f4efe7 70%,
                #e7dfd3 100%
            );
    }

    .product-image::after {
        content: "";

        position: absolute;

        left: 15%;
        right: 15%;

        bottom: 10px;

        height: 25px;

        background: rgba(0,0,0,.13);

        filter: blur(18px);

        border-radius: 50%;
    }

    .product-img {
        width: 100%;
        height: 100%;

        object-fit: cover;

        transition:
            transform .7s ease,
            filter .5s ease;
    }

    .product-card:hover .product-img {
        transform: scale(1.08);
    }


    /* =========================================================
       FAVORITE
       ========================================================= */

    .favorite-btn {
        position: absolute;

        top: 16px;
        right: 16px;

        width: 44px;
        height: 44px;

        padding: 0;

        border-radius: 50%;

        border:
            1px solid rgba(198,161,91,.35);

        background:
            rgba(255,255,255,.8) !important;

        backdrop-filter: blur(12px);

        color: #777;

        display: flex;

        justify-content: center;
        align-items: center;

        font-size: 20px;

        cursor: pointer;

        z-index: 30;

        box-shadow:
            0 8px 20px rgba(0,0,0,.12);

        transition:
            transform .3s ease,
            background .3s ease,
            box-shadow .3s ease;
    }

    .favorite-btn:hover {
        transform: scale(1.12);

        background: #111 !important;

        box-shadow:
            0 8px 25px rgba(198,161,91,.35);
    }

    .favorite-btn i {
        transition: .3s ease;
    }

    .favorite-btn:hover i {
        color: #C6A15B;
    }

    .favorite-btn.liked i {
        color: #d90429;
    }


    /* =========================================================
       BADGE
       ========================================================= */

    .product-card .badge {
        position: absolute;

        top: 18px;
        left: 18px;

        z-index: 20;

        padding: 7px 12px;

        border-radius: 20px;

        background: #111;

        color: #C6A15B;

        border:
            1px solid rgba(198,161,91,.5);

        font-size: 9px;

        line-height: 1.2;

        letter-spacing: 1px;

        text-align: center;

        box-shadow:
            0 8px 20px rgba(0,0,0,.2);
    }


    /* =========================================================
       CARD CONTENT
       ========================================================= */

    .card-content {
        padding: 18px 22px 24px;

        text-align: center;
    }

    .stars {
        color: #C6A15B;

        font-size: 13px;

        letter-spacing: 3px;

        margin-bottom: 7px;
    }

    .product-name {
        font-size: 20px;

        font-weight: 700;

        margin: 8px 0;

        color: #111;

        letter-spacing: .4px;
    }

    .product-description {
        color: #777;

        font-size: 13px;

        line-height: 1.6;

        margin: 8px auto;

        max-width: 230px;

        max-height: 45px;

        overflow: hidden;
    }

    .price {
        color: #C6A15B;

        font-size: 23px;

        font-weight: 700;

        margin-top: 12px;
    }


    /* =========================================================
       CART BUTTON
       ========================================================= */

    .cart-btn {
        position: relative;

        display: flex;

        align-items: center;
        justify-content: center;

        width: 100%;

        padding: 13px 20px;

        margin-top: 16px;

        border-radius: 50px;

        background: #1A4639;

        color: #C6A15B !important;

        border: 1px solid #C6A15B;

        text-decoration: none;

        font-size: 13px;

        font-weight: 600;

        letter-spacing: 1px;

        overflow: hidden;

        transition:
            transform .3s ease,
            background .3s ease,
            box-shadow .3s ease;
    }

    .cart-btn::before {
        content: "";

        position: absolute;

        top: 0;
        left: -120%;

        width: 80%;
        height: 100%;

        background:
            linear-gradient(
                120deg,
                transparent,
                rgba(255,255,255,.75),
                transparent
            );

        transition: .6s ease;
    }

    .cart-btn:hover::before {
        left: 130%;
    }

    .cart-btn:hover {
        background: #0F2E26;

        color: #C6A15B !important;

        transform: translateY(-3px);

        box-shadow:
            0 10px 25px rgba(26,70,57,.35);
    }


    /* =========================================================
       LARGE TABLET / SMALL LAPTOP
       ========================================================= */

    @@media (max-width: 1100px) {

        .luxe-banner {
            margin: 30px 20px;

            padding: 90px 40px;
        }

        .luxe-banner h1 {
            font-size: 48px;
        }

        .shop-controls {
            margin-left: 25px;
            margin-right: 25px;
        }

        .products-slider-container {
            padding-left: 60px;
            padding-right: 60px;
        }
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 900px) {

        .luxe-banner {
            padding: 75px 30px;

            border-radius: 26px;
        }

        .luxe-banner h1 {
            font-size: 42px;
        }

        .luxe-banner p {
            font-size: 14px;
        }

        .shop-controls {
            margin:
                50px 20px 30px;

            align-items: flex-start;
        }

        .shop-heading h2 {
            font-size: 30px;
        }

        .shop-actions {
            width: 100%;
        }

        .search-form {
            flex: 1;
        }

        .search-input {
            width: 100%;
        }

        .products-slider-container {
            padding:
                20px 55px;
        }
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 700px) {

        .container {
            width: 100%;
            padding: 0 10px;
        }


        /* HERO */

        .luxe-banner {
            margin: 20px 0 30px;

            padding:
                65px 18px;

            border-radius: 22px;
        }

        .luxe-banner span {
            padding: 7px 15px;

            font-size: 10px;

            letter-spacing: 1.5px;

            margin-bottom: 16px;
        }

        .luxe-banner h1 {
            font-size: 32px;

            line-height: 1.2;

            margin-bottom: 15px;
        }

        .luxe-banner p {
            font-size: 12px;

            line-height: 1.7;

            max-width: 320px;
        }

        .luxe-btn {
            margin-top: 25px;

            padding:
                13px 28px;

            font-size: 11px;
        }


        /* SHOP CONTROLS */

        .shop-controls {
            margin:
                40px 5px 25px;

            flex-direction: column;

            align-items: stretch;

            gap: 22px;
        }

        .shop-heading {
            text-align: center;
        }

        .shop-heading h2 {
            font-size: 27px;

            margin-bottom: 6px;
        }

        .shop-heading p {
            font-size: 11px;

            line-height: 1.5;
        }

        .shop-actions {
            width: 100%;

            gap: 10px;
        }

        .search-form {
            width: 100%;

            gap: 8px;
        }

        .search-input {
            min-width: 0;

            width: 100%;

            padding:
                12px 16px;

            font-size: 12px;
        }

        .search-btn {
            flex-shrink: 0;

            padding:
                12px 18px;

            font-size: 10px;
        }

        .cart-icon-link {
            flex-shrink: 0;

            width: 42px;
            height: 42px;

            font-size: 23px;
        }

        .cart-number {
            width: 18px;
            height: 18px;

            font-size: 9px;

            top: -2px;
            right: -2px;
        }


        /* BRAND */

        .brand-divider {
            margin:
                45px 0 20px;
        }

        .brand-title {
            font-size: 23px;

            letter-spacing: 1.5px;
        }

        .brand-title::after {
            width: 55px;

            height: 2px;

            margin:
                10px auto;
        }


        /* PRODUCTS */

        .products-slider-container {
            padding:
                10px 2px 20px;
        }

        .products-grid {
            display: grid;

            grid-template-columns:
                repeat(2, minmax(0, 1fr));

            gap: 14px;

            overflow: visible;

            padding:
                5px 0 20px;
        }

        .slider-btn {
            display: none !important;
        }


        /* CARD */

        .product-card {
    min-width: 0 !important;
    width: 100% !important;
    flex: none !important;

    height: 300px !important;
    min-height: 300px !important;
    max-height: 300px !important;

    border-radius: 17px;
}


        /* IMAGE */

        .product-image {
            height: 145px !important;
        }


        /* FAVORITE */

        .favorite-btn {
            width: 30px;
            height: 30px;

            top: 7px;
            right: 7px;

            font-size: 13px;
        }


        /* BADGE */

        .product-card .badge {
            top: 7px;
            left: 7px;

            padding:
                4px 6px;

            font-size: 6px;

            letter-spacing: .5px;
        }


        /* CONTENT */

        .card-content {
            padding:
                9px 8px 11px;
        }

        .stars {
            font-size: 8px;

            letter-spacing: 1px;

            margin-bottom: 3px;
        }

        .product-name {
            font-size: 13px;

            margin:
                4px 0;
        }

        .product-description {
            font-size: 9px;

            line-height: 1.3;

            margin:
                4px auto;

            max-height: 27px;
        }

        .price {
            font-size: 16px;

            margin-top: 6px;
        }

        .cart-btn {
            padding:
                8px 5px;

            margin-bottom: 12px;

            font-size: 8px;

            letter-spacing: .5px;
        }
    }


    /* =========================================================
       SMALL MOBILE — 480px
       ========================================================= */

    @@media (max-width: 480px) {

        .container {
            padding:
                0 8px;
        }


        /* HERO */

        .luxe-banner {
            margin-top: 15px;

            padding:
                55px 15px;

            border-radius: 20px;
        }

        .luxe-banner span {
            font-size: 9px;

            padding:
                6px 13px;

            letter-spacing: 1.2px;
        }

        .luxe-banner h1 {
            font-size: 28px;
        }

        .luxe-banner p {
            font-size: 11px;
        }

        .luxe-btn {
            padding:
                12px 24px;

            font-size: 10px;
        }


        /* SHOP */

        .shop-controls {
            margin:
                35px 3px 20px;
        }

        .shop-heading h2 {
            font-size: 24px;
        }

        .shop-heading p {
            font-size: 10px;
        }

        .search-input {
            padding:
                11px 14px;

            font-size: 11px;
        }

        .search-btn {
            padding:
                11px 15px;

            font-size: 9px;
        }


        /* BRAND */

        .brand-divider {
            margin:
                38px 0 16px;
        }

        .brand-title {
            font-size: 20px;
        }


        /* GRID */

        .products-slider-container {
            padding:
                8px 0 15px;
        }

        .products-grid {
            grid-template-columns:
            repeat(2, minmax(0, 1fr));
            row-gap: 20px;
            column-gap: 12px;
            
        }


        /* CARD */

        .product-card {
            height: 250px !important;

            min-height: 250px !important;

            max-height: 250px !important;

            border-radius: 15px;
        }

        .product-image {
            height: 125px !important;
        }


        /* CARD CONTENT */

        .card-content {
            padding:
                7px 6px 9px;
        }

        .stars {
            font-size: 7px;

            letter-spacing: .5px;
        }

        .product-name {
            font-size: 11px;

            margin:
                3px 0;
        }

        .product-description {
            font-size: 8px;

            line-height: 1.25;

            max-height: 25px;

            margin:
                3px auto;
        }

        .price {
            font-size: 14px;

            margin-top: 4px;
        }

        .cart-btn {
            padding:
                7px 4px;

            margin-bottom: 10px;

            font-size: 7px;
        }

        .favorite-btn {
            width: 27px;
            height: 27px;

            font-size: 11px;
        }

        .product-card .badge {
            font-size: 5px;

            padding:
                3px 4px;
        }
    }


    /* =========================================================
       VERY SMALL MOBILE — 375px
       ========================================================= */

    @@media (max-width: 375px) {

        .container {
            padding:
                0 6px;
        }

        .luxe-banner {
            padding:
                48px 12px;
        }

        .luxe-banner h1 {
            font-size: 25px;
        }

        .luxe-banner p {
            font-size: 10px;
        }

        .shop-heading h2 {
            font-size: 22px;
        }

        .shop-actions {
            gap: 7px;
        }

        .search-form {
            gap: 6px;
        }

        .search-input {
            padding:
                10px 12px;

            font-size: 10px;
        }

        .search-btn {
            padding:
                10px 12px;

            font-size: 8px;
        }

        .cart-icon-link {
            width: 38px;
            height: 38px;

            font-size: 21px;
        }

        .products-grid {
            gap: 10px;
        }

        .product-card {
            height: 270px !important;

            min-height: 270px !important;

            max-height: 270px !important;
        }

        .product-image {
            height: 115px !important;
        }

        .product-name {
            font-size: 10px;
        }

        .product-description {
            font-size: 7px;

            max-height: 23px;
        }

        .price {
            font-size: 13px;
        }

        .cart-btn {
            font-size: 6.5px;

            padding:
                6px 3px;
        }
    }


    /* =========================================================
       EXTRA SMALL — 320px
       ========================================================= */

    @@media (max-width: 330px) {

        .luxe-banner h1 {
            font-size: 22px;
        }

        .luxe-banner span {
            font-size: 8px;

            padding:
                5px 10px;
        }

        .luxe-btn {
            padding:
                10px 20px;

            font-size: 9px;
        }

        .shop-heading h2 {
            font-size: 20px;
        }

        .shop-heading p {
            font-size: 9px;
        }

        .products-grid {
            gap: 8px;
        }

        .product-card {
